                            internalPattern := complexPattern
                            internalCount := complexCount
                            correctionReason := complexReason
                            correctionTerminalIndex := complexTerminalIndex
                        else if not correctionConfirmed and complexReason == "DOUBLE_CONFIRMATION_PENDING"
                            correctionPrimary := complexPrimary
                            bRatio := complexXRatio
