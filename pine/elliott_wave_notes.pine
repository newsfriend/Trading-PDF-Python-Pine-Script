//@version=6
indicator("Elliott Wave Notes Overlay", overlay=true, max_lines_count=500, max_labels_count=500)

// Post-Y confirmation uses a runtime-calculated close[offset]. Pine cannot
// always infer the required historical buffer for dynamic offsets, so size
// only the close buffer to the platform maximum instead of expanding every
// series through indicator(max_bars_back=...).
max_bars_back(close, 5000)

// Source notes:
// - EW Notes / Chartking material
// - EWT cheat sheet
// - Rules & Guidelines Summary EW Theory
// - Time analysis notes
// - Elliott Wave / NeoWave V4.0 Merged Zero-Knowledge Developer Master
//
// Candidate State is the default source-locked engine. Legacy fixed-cycle mode
// is retained only for comparison and is not an acceptance mode.

groupEngine = "Engine / Degree"
engineMode = input.string("Candidate State (V4 Full Cycle)", "Engine mode", options=["Candidate State (V4 Full Cycle)", "Candidate State (Phase 1)", "Legacy fixed cycle"], group=groupEngine)
degreePreset = input.string("Chartking Day Trading", "Degree preset", options=["Chartking Day Trading", "Hardik 1Y", "Hardik Swing", "Hardik Day Trading", "Manual"], group=groupEngine)
manualDegreeTimeframe = input.timeframe("D", "Manual Important H/L timeframe", group=groupEngine)
importantLookbackDays = input.int(144, "Important H/L source bars", minval=10, group=groupEngine, tooltip="Default uses 144 Daily source candles, not 144 local chart candles.")
baseOscillatorMode = input.string("Extreme or divergence", "Base oscillator rule", options=["Extreme or divergence", "Extreme only", "Divergence only", "Extreme and divergence", "Off"], group=groupEngine)
showDevelopingCandidates = input.bool(true, "Show developing/alternate status", group=groupEngine)
degreeSourceTimeframe = degreePreset == "Manual" ? manualDegreeTimeframe : degreePreset == "Hardik 1Y" ? "M" : "D"
degreeName = degreePreset == "Hardik 1Y" ? "Primary" : degreePreset == "Hardik Swing" ? "Intermediate" : "Major"

groupSwing = "Swing Detection"
pivotLeft = input.int(5, "Pivot left", minval=1, group=groupSwing)
pivotRight = input.int(5, "Pivot right", minval=1, group=groupSwing)
maxSwings = input.int(120, "Maximum swings retained", minval=45, maxval=120, group=groupSwing, tooltip="Core impulse extensions can require up to 85 raw pivots before Waves 1-5 are complete.")
minSwingAtrMultiple = input.float(1.5, "Minimum swing ATR multiple", minval=0.0, step=0.1, group=groupSwing)
minSwingRangePct = input.float(3.0, "Minimum swing % of Important H/L", minval=0.0, step=0.1, group=groupSwing) / 100.0
showZero = input.bool(false, "Show 0 labels", group=groupSwing)

groupStart = "Wave 1 Start"
wave1StartMode = input.string("Important swing + oscillator", "Start filter", options=["Off", "Important swing", "Important swing + oscillator"], group=groupStart)
anchorDirection = input.string("Auto", "Anchor direction", options=["Auto", "Bullish from important low", "Bearish from important high"], group=groupStart)
importantAtrLength = input.int(14, "Important swing ATR length", minval=1, group=groupStart)
importantAtrMultiple = input.float(1.0, "Important swing ATR multiple", minval=0.0, step=0.1, group=groupStart)
rsiLength = input.int(13, "RSI length", minval=1, group=groupStart)
macdFast = input.int(12, "MACD fast", minval=1, group=groupStart)
macdSlow = input.int(26, "MACD slow", minval=1, group=groupStart)
macdSignal = input.int(9, "MACD signal", minval=1, group=groupStart)
oscillatorLookback = input.int(100, "MACD extreme lookback", minval=5, group=groupStart)
importantLookback = input.int(144, "Legacy Important H/L chart bars", minval=10, group=groupStart)
degreeRetrace = input.float(61.8, "Degree retracement % of Important H/L", minval=1.0, step=0.1, group=groupStart) / 100.0

groupRules = "EW Notes Rules"
showRuleWarnings = input.bool(true, "Color rule warnings", group=groupRules)
wave2MinimumMode = input.string("Chartking", "Wave 2 minimum source", options=["Chartking", "Hardik", "Legacy 14%"], group=groupRules)
wave2MinRetrace = input.float(23.6, "Wave 2 normal minimum %", minval=0.0, step=0.1, group=groupRules) / 100.0
wave2MaxRetrace = input.float(81.2, "Wave 2 normal maximum %", minval=1.0, step=0.1, group=groupRules) / 100.0
microscopicRetrace = input.float(14.0, "Wave 2 microscopic clue %", minval=0.0, step=0.1, group=groupRules) / 100.0
microscopicTolerance = input.float(2.0, "Microscopic tolerance %", minval=0.0, step=0.1, group=groupRules) / 100.0
wave2MaxTime = input.float(2.0, "Wave 2 maximum time x Wave 1", minval=0.1, step=0.1, group=groupRules)
wave3MinExtension = input.float(161.8, "Wave 3 expected minimum % of Wave 1", minval=1.0, step=0.1, group=groupRules) / 100.0
wave3TerminalMin = input.float(61.8, "Wave 3 terminal minimum %", minval=1.0, step=0.1, group=groupRules) / 100.0
wave3MaximumMode = input.string("Chartking 2700%", "Wave 3 maximum source", options=["Chartking 2700%", "Impulse 2100%"], group=groupRules)
wave4MinimumMode = input.string("Chartking", "Wave 4 minimum source", options=["Chartking", "Hardik", "Extension context"], group=groupRules)
wave4MinRetrace = input.float(23.6, "Wave 4 normal minimum %", minval=0.0, step=0.1, group=groupRules) / 100.0
wave4MaxRetrace = input.float(50.0, "Wave 4 usual maximum retrace %", minval=0.0, step=0.1, group=groupRules) / 100.0
wave4TerminalMaxRetrace = input.float(61.8, "Wave 4 terminal maximum %", minval=0.0, step=0.1, group=groupRules) / 100.0
flatAMinRetrace = input.float(38.2, "Flat A minimum retrace %", minval=0.0, step=0.1, group=groupRules) / 100.0
flatBMinRetrace = input.float(61.8, "Flat B minimum retrace %", minval=0.0, step=0.1, group=groupRules) / 100.0
flatBMaxRetrace = input.float(111.0, "Flat B maximum retrace %", minval=1.0, step=0.1, group=groupRules) / 100.0
wave5MinExtension = input.float(127.0, "Wave 5 minimum % of Wave 3-4", minval=1.0, step=0.1, group=groupRules) / 100.0
wave5MaxExtension = input.float(261.8, "Wave 5 maximum % of Wave 3-4", minval=1.0, step=0.1, group=groupRules) / 100.0
wave5DivergenceMode = input.string("Support", "Wave 5 divergence rule", options=["Support", "Required", "Off"], group=groupRules)
timeRuleMode = input.string("Diagnostic all sources", "Time rule source", options=["Diagnostic all sources", "Chartking", "Hardik", "Separate Time Analysis"], group=groupRules)
hpSignalMode = input.string("Structure confirmation only", "HP signal mode", options=["Structure confirmation only", "Disabled"], group=groupRules)
timeToleranceBars = input.int(8, "Time rule tolerance (closed bars)", minval=0, group=groupRules)
// Legacy display diagnostics below use a normalized tolerance only for color.
// V4 confirmation gates use the fixed closed-bar tolerance above.
timeTolerance = 0.25

groupDisplay = "Display"
correctionPattern = input.string("A-B-C", "Correction labels", options=["A-B-C", "W-X-Y", "W-X-Y-XX-Z", "A-B-C-D-E"], group=groupDisplay)
showWave4Internal = input.bool(true, "Show Wave 4 internal A/B/C", group=groupDisplay)
countDisplayMode = input.string("Validated Anchor", "Count mode", options=["Validated Anchor", "All swings"], group=groupDisplay)
showTargets = input.bool(true, "Show Wave 5 target zone", group=groupDisplay)
showAnchorFib = input.bool(true, "Show Important H/L fib guide", group=groupDisplay)
showTimeTable = input.bool(true, "Show time rules table", group=groupDisplay)
showDegreeDashboard = input.bool(true, "Show nine-degree router", group=groupDisplay)
impulseLineColor = input.color(color.rgb(255, 128, 0), "Impulse line", group=groupDisplay)
correctionLineColor = input.color(color.rgb(0, 160, 160), "Correction line", group=groupDisplay)
fibLineColor = input.color(color.rgb(0, 80, 255), "Important H/L fib", group=groupDisplay)
labelTextColor = input.color(color.white, "Label text", group=groupDisplay)
labelSizeInput = input.string("small", "Label size", options=["tiny", "small", "normal"], group=groupDisplay)

var swingBars = array.new_int()
var swingPrices = array.new_float()
var swingTypes = array.new_int()
var swingAtr = array.new_float()
var swingMacdHist = array.new_float()
var swingRsi = array.new_float()
var swingMacdExtreme = array.new_bool()
var swingImportantExtreme = array.new_bool()
var swingImportantRange = array.new_float()
var swingImportantHigh = array.new_float()
var swingImportantLow = array.new_float()
var drawnLines = array.new_line()
var drawnLabels = array.new_label()
var targetLines = array.new_line()
var anchorFibLines = array.new_line()
var anchorFibLabels = array.new_label()
var channelLines = array.new_line()
var table timeTable = table.new(position.top_right, 2, 7, border_width=1)
var table degreeTable = table.new(position.bottom_right, 5, 10, border_width=1)

// Confirmed values are copied out of the raw swing arrays so later raw pivot
// replacements cannot move any locked main-degree label.
var string candidateState = "SEARCHING"
var string lastReasonCode = "SEARCHING_FOR_BASE"
var bool baseLocked = false
var bool lockedBullish = false
var int lockedBaseBar = na
var float lockedBasePrice = na
var int lockedW1Bar = na
var float lockedW1Price = na
var int lockedAtBar = na
var float lockedDegreeProgress = na
var int lockedInternalCount = na
var string lockedW1Subtype = ""
var float lockedImportantHigh = na
var float lockedImportantLow = na
var int searchFloorBar = -1
var int recountCount = 0
var int alternateBaseCount = 0
var int lastInvalidBar = na
var float lastInvalidPrice = na
var string developingText = ""
var string engineStage = "SEARCHING"
var string primaryPattern = ""
var string alternatePattern = ""
var string currentFibAnchor = ""
var float currentFibValue = na
var float currentTimeValue = na
var string currentInternalPattern = ""
var int currentInternalCount = 0
var string currentMacdState = ""
var string currentNextCondition = "Need qualified Point 0 and Wave 1"
var string hpSignalState = ""
var float currentConfidence = na
float routeConfidenceBonus = 0.0
var string currentChannelState = ""
var float currentChannelTarget = na
var string currentTargetCluster = ""
var string fbdCandidateState = ""
var int lockedW2Bar = na
var float lockedW2Price = na
var string lockedW2Pattern = ""
var string lockedW2Subtype = ""
var int lockedW2InternalCount = 0
var float lockedW2Retrace = na
var int lockedW3Bar = na
var float lockedW3Price = na
var string lockedW3Subtype = ""
var int lockedW3InternalCount = 0
var float lockedW3Ratio = na
var float lockedW3Macd = na
var int lockedW4Bar = na
var float lockedW4Price = na
var string lockedW4Pattern = ""
var float lockedW4Retrace = na
var int lockedW5Bar = na
var float lockedW5Price = na
var string lockedW5Subtype = ""
var float lockedW5Ratio = na
var int lockedABar = na
var float lockedAPrice = na
var int lockedBBar = na
var float lockedBPrice = na
var int lockedCBar = na
var float lockedCPrice = na
var int lockedDBar = na
var float lockedDPrice = na
var int lockedEBar = na
var float lockedEPrice = na
var string lockedCorrectionPattern = ""
var float lockedTriangleTargetNear = na
var float lockedTriangleTargetFar = na
var float lockedTriangleInvalidation = na

f_label_size() =>
    labelSizeInput == "tiny" ? size.tiny : labelSizeInput == "normal" ? size.normal : size.small

f_locked_correction_label(position) =>
    lockedCorrectionPattern == "W-X-Y" ? (position == 0 ? "W" : position == 1 ? "X" : "Y") : lockedCorrectionPattern == "W-X-Y-XX-Z" ? (position == 0 ? "W" : position == 1 ? "X" : position == 2 ? "Y" : position == 3 ? "XX" : "Z") : position == 0 ? "A" : position == 1 ? "B" : position == 2 ? "C" : position == 3 ? "D" : "E"

f_correction_count() =>
    correctionPattern == "W-X-Y-XX-Z" or correctionPattern == "A-B-C-D-E" ? 5 : 3

f_cycle_length() =>
    (showWave4Internal ? 8 : 6) + f_correction_count()

f_phase(index) =>
    index % f_cycle_length()

f_correction_text(offset) =>
    if correctionPattern == "W-X-Y"
        offset == 0 ? "W" : offset == 1 ? "X" : "Y"
    else if correctionPattern == "W-X-Y-XX-Z"
        offset == 0 ? "W" : offset == 1 ? "X" : offset == 2 ? "Y" : offset == 3 ? "XX" : "Z"
    else if correctionPattern == "A-B-C-D-E"
        offset == 0 ? "(A)" : offset == 1 ? "(B)" : offset == 2 ? "(C)" : offset == 3 ? "(D)" : "(E)"
    else
        offset == 0 ? "(A)" : offset == 1 ? "(B)" : "(C)"

f_phase_text(phase) =>
    if showWave4Internal
        phase <= 3 ? (phase == 0 ? "0" : str.tostring(phase)) : phase == 4 ? "(A)" : phase == 5 ? "(B)" : phase == 6 ? "4\n(C)" : phase == 7 ? "5" : f_correction_text(phase - 8)
    else
        phase <= 5 ? (phase == 0 ? "0" : str.tostring(phase)) : f_correction_text(phase - 6)

f_is_impulse_phase(phase) =>
    showWave4Internal ? (phase <= 3 or phase == 7) : phase <= 5

f_wave4_complete_phase() =>
    showWave4Internal ? 6 : 4

f_wave5_phase() =>
    showWave4Internal ? 7 : 5
f_clear_drawings() =>
    if array.size(drawnLines) > 0
        for i = 0 to array.size(drawnLines) - 1
            line.delete(array.get(drawnLines, i))
    if array.size(drawnLabels) > 0
        for i = 0 to array.size(drawnLabels) - 1
            label.delete(array.get(drawnLabels, i))
    if array.size(targetLines) > 0
        for i = 0 to array.size(targetLines) - 1
            line.delete(array.get(targetLines, i))
    if array.size(anchorFibLines) > 0
        for i = 0 to array.size(anchorFibLines) - 1
            line.delete(array.get(anchorFibLines, i))
    if array.size(anchorFibLabels) > 0
        for i = 0 to array.size(anchorFibLabels) - 1
            label.delete(array.get(anchorFibLabels, i))
    if array.size(channelLines) > 0
        for i = 0 to array.size(channelLines) - 1
            line.delete(array.get(channelLines, i))
    array.clear(drawnLines)
    array.clear(drawnLabels)
    array.clear(targetLines)
    array.clear(anchorFibLines)
    array.clear(anchorFibLabels)
    array.clear(channelLines)
f_previous_same_type_index(index, pivotType) =>
    found = -1
    if index > 0
        for j = 0 to index - 1
            checkIndex = index - 1 - j
            if found == -1 and array.get(swingTypes, checkIndex) == pivotType
                found := checkIndex
    found

f_candidate_oscillator(startIndex, bullish) =>
    extremeOk = array.get(swingMacdExtreme, startIndex)
    divergenceOk = false
    startType = array.get(swingTypes, startIndex)
    previousIndex = f_previous_same_type_index(startIndex, startType)
    if previousIndex >= 0
        startPrice = array.get(swingPrices, startIndex)
        previousPrice = array.get(swingPrices, previousIndex)
        startRsi = array.get(swingRsi, startIndex)
        previousRsi = array.get(swingRsi, previousIndex)
        startMacd = array.get(swingMacdHist, startIndex)
        previousMacd = array.get(swingMacdHist, previousIndex)
        priceExtends = bullish ? startPrice < previousPrice : startPrice > previousPrice
        rsiDiverges = bullish ? startRsi > previousRsi : startRsi < previousRsi
        macdDiverges = bullish ? startMacd > previousMacd : startMacd < previousMacd
        divergenceOk := priceExtends and (rsiDiverges or macdDiverges)
    oscillatorOk = baseOscillatorMode == "Off" ? true : baseOscillatorMode == "Extreme only" ? extremeOk : baseOscillatorMode == "Divergence only" ? divergenceOk : baseOscillatorMode == "Extreme and divergence" ? extremeOk and divergenceOk : extremeOk or divergenceOk
    [oscillatorOk, extremeOk, divergenceOk]

f_candidate_crosses_origin(startIndex, endIndex, bullish) =>
    crossed = false
    basePrice = array.get(swingPrices, startIndex)
    if endIndex > startIndex
        for checkIndex = startIndex + 1 to endIndex
            checkType = array.get(swingTypes, checkIndex)
            checkPrice = array.get(swingPrices, checkIndex)
            if bullish and checkType == -1 and checkPrice <= basePrice
                crossed := true
            if not bullish and checkType == 1 and checkPrice >= basePrice
                crossed := true
    crossed

f_eval_diagonal(startIndex, endIndex, diagonalKind) =>
    leading = diagonalKind == "leading"
    expectedCount = leading ? 21 : 15
    confirmed = false
    subtype = leading ? "LEADING_DIAGONAL_FORMING" : "ENDING_DIAGONAL_FORMING"
    reason = "DIAGONAL_INTERNAL_FAIL"
    divergence = false
    internalPattern = leading ? "5-3-5-3-5" : "3-3-3-3-3"
    if startIndex >= 0 and endIndex - startIndex == expectedCount
        i1 = startIndex + (leading ? 5 : 3)
        i2 = i1 + 3
        i3 = i2 + (leading ? 5 : 3)
        i4 = i3 + 3
        i5 = i4 + (leading ? 5 : 3)
        p0 = array.get(swingPrices, startIndex)
        p1 = array.get(swingPrices, i1)
        p2 = array.get(swingPrices, i2)
        p3 = array.get(swingPrices, i3)
        p4 = array.get(swingPrices, i4)
        p5 = array.get(swingPrices, i5)
        bullish = array.get(swingTypes, startIndex) == -1 and array.get(swingTypes, i5) == 1 and p5 > p0
        bearish = array.get(swingTypes, startIndex) == 1 and array.get(swingTypes, i5) == -1 and p5 < p0
        advances = bullish ? p3 > p1 and p5 > p3 and p4 > p2 : bearish ? p3 < p1 and p5 < p3 and p4 < p2 : false
        overlap = bullish ? p4 <= p1 : bearish ? p4 >= p1 : false
        wave2BoundaryPass = bullish ? p4 > p2 : bearish ? p4 < p2 : false
        earlyWidth = math.abs(p1 - p2)
        lateWidth = math.abs(p3 - p4)
        wedge = advances and math.abs(earlyWidth - lateWidth) > 0.000000001
        wedgeSubtype = lateWidth < earlyWidth ? "CONTRACTING" : "EXPANDING"
        divergence := bullish ? array.get(swingMacdHist, i5) < array.get(swingMacdHist, i3) : bearish ? array.get(swingMacdHist, i5) > array.get(swingMacdHist, i3) : false
        w1Length = math.abs(p1 - p0)
        w3Ratio = w1Length > 0 ? math.abs(p3 - p2) / w1Length : na
        baseTo3 = math.abs(p3 - p0)
        w4Retrace = baseTo3 > 0 ? math.abs(p3 - p4) / baseTo3 : na
        w5Ratio = w1Length > 0 ? math.abs(p5 - p4) / w1Length : na
        leadingFibPass = not na(w3Ratio) and w3Ratio >= 0.618 and w3Ratio < 1.618 and not na(w4Retrace) and w4Retrace >= 0.236 and w4Retrace <= 0.618 and not na(w5Ratio) and ((w5Ratio >= 1.618 and w5Ratio <= 2.618) or math.abs(w5Ratio - 1.0) <= 0.02)
        confirmed := overlap and wave2BoundaryPass and wedge and (leading ? leadingFibPass : divergence)
        subtype := (leading ? "LEADING_DIAGONAL_" : "ENDING_DIAGONAL_") + wedgeSubtype
        reason := confirmed ? "DIAGONAL_CONFIRMED" : not overlap or not wave2BoundaryPass ? "DIAGONAL_OVERLAP_FAIL" : not wedge ? "DIAGONAL_WEDGE_FAIL" : leading ? "LEADING_DIAGONAL_FIB_FAIL" : "ENDING_DIAGONAL_DIVERGENCE_FAIL"
    [confirmed, subtype, reason, divergence, internalPattern]

f_candidate_for_count(endIndex, internalCount) =>
    startIndex = endIndex - internalCount
    valid = false
    progress = float(na)
    bullish = false
    note = ""
    candidateSubtype = internalCount > 5 ? "EXTENDED_W1" : "NORMAL_W1"
    if startIndex >= 0
        startBar = array.get(swingBars, startIndex)
        startPrice = array.get(swingPrices, startIndex)
        endPrice = array.get(swingPrices, endIndex)
        startType = array.get(swingTypes, startIndex)
        endType = array.get(swingTypes, endIndex)
        bullish := startType == -1 and endType == 1 and endPrice > startPrice
        bearish = startType == 1 and endType == -1 and endPrice < startPrice
        directionOk = anchorDirection == "Auto" ? true : anchorDirection == "Bullish from important low" ? bullish : bearish
        importantOk = wave1StartMode == "Off" or array.get(swingImportantExtreme, startIndex)
        importantRange = array.get(swingImportantRange, startIndex)
        distance = math.abs(endPrice - startPrice)
        progress := not na(importantRange) and importantRange > 0 ? distance / importantRange : na
        degreeOk = not na(progress) and progress >= degreeRetrace
        startAtr = array.get(swingAtr, startIndex)
        atrOk = importantAtrMultiple <= 0 or not na(startAtr) and distance >= startAtr * importantAtrMultiple
        [oscillatorEvidence, extremeOk, divergenceOk] = f_candidate_oscillator(startIndex, bullish)
        oscillatorOk = wave1StartMode == "Important swing" ? true : oscillatorEvidence
        originOk = not f_candidate_crosses_origin(startIndex, endIndex, bullish)
        floorOk = startBar >= searchFloorBar
        valid := (bullish or bearish) and directionOk and importantOk and degreeOk and atrOk and oscillatorOk and originOk and floorOk
        [leadingConfirmed, leadingSubtype, leadingReason, leadingDivergence, leadingPattern] = f_eval_diagonal(startIndex, endIndex, "leading")
        candidateSubtype := leadingConfirmed ? leadingSubtype : candidateSubtype
        note := "W1 " + candidateSubtype + " | " + str.tostring(internalCount) + " moves | degree " + str.tostring(progress * 100.0, "#.##") + "% | extreme " + (extremeOk ? "yes" : "no") + " | divergence " + (divergenceOk ? "yes" : "no")
    [valid, startIndex, bullish, progress, candidateSubtype, note]

f_find_phase1_candidate() =>
    endIndex = array.size(swingBars) - 1
    foundStart = -1
    foundBullish = false
    foundProgress = float(na)
    foundCount = -1
    foundSubtype = ""
    foundNote = ""
    if endIndex >= 5
        for countIndex = 0 to 4
            internalCount = countIndex == 0 ? 5 : countIndex == 1 ? 9 : countIndex == 2 ? 13 : countIndex == 3 ? 17 : 21
            [valid, startIndex, bullish, progress, candidateSubtype, note] = f_candidate_for_count(endIndex, internalCount)
            if foundStart == -1 and valid
                foundStart := startIndex
                foundBullish := bullish
                foundProgress := progress
                foundCount := internalCount
                foundSubtype := candidateSubtype
                foundNote := note
    [foundStart, endIndex, foundBullish, foundProgress, foundCount, foundSubtype, foundNote]

f_is_candidate_mode() =>
    engineMode != "Legacy fixed cycle"

f_impulse_count(optionIndex) =>
    optionIndex == 0 ? 5 : optionIndex == 1 ? 9 : optionIndex == 2 ? 13 : optionIndex == 3 ? 17 : 21

f_c_motive_count(optionIndex) =>
    optionIndex == 0 ? 5 : optionIndex == 1 ? 9 : optionIndex == 2 ? 13 : optionIndex == 3 ? 15 : optionIndex == 4 ? 17 : 21

f_correction_count_option(optionIndex) =>
    optionIndex == 0 ? 3 : optionIndex == 1 ? 7 : 11

f_is_impulse_count(count) =>
    count == 5 or count == 9 or count == 13 or count == 17 or count == 21

f_index_for_bar(targetBar) =>
    found = -1
    if array.size(swingBars) > 0
        for i = 0 to array.size(swingBars) - 1
            if array.get(swingBars, i) == targetBar
                found := i
    found

f_ratio(numerator, denominator) =>
    denominator == 0 or na(denominator) ? na : numerator / denominator

f_degree_route_snapshot(routePivotLength) =>
    routeHigh = ta.pivothigh(high, routePivotLength, routePivotLength)
    routeLow = ta.pivotlow(low, routePivotLength, routePivotLength)
    routeType = not na(routeHigh) ? 1 : not na(routeLow) ? -1 : 0
    routePrice = routeType == 1 ? routeHigh : routeType == -1 ? routeLow : na
    var int lastRouteType = 0
    var float lastRoutePrice = na
    var float routeOrigin = na
    var int routeMoves = 0
    var int routeDirection = 0
    if routeType != 0
        if lastRouteType == 0
            lastRouteType := routeType
            lastRoutePrice := routePrice
            routeOrigin := routePrice
        else if routeType == lastRouteType
            moreExtreme = routeType == 1 ? routePrice > lastRoutePrice : routePrice < lastRoutePrice
            if moreExtreme
                lastRoutePrice := routePrice
        else
            routeMoves += 1
            lastRouteType := routeType
            lastRoutePrice := routePrice
            routeRange = ta.highest(high, 144) - ta.lowest(low, 144)
            routeProgress = routeRange > 0 ? math.abs(routePrice - routeOrigin) / routeRange : na
            motiveCount = routeMoves == 5 or routeMoves == 9 or routeMoves == 13 or routeMoves == 17 or routeMoves == 21
            if motiveCount and not na(routeProgress) and routeProgress >= 0.618
                routeDirection := routePrice > routeOrigin ? 1 : -1
            if routeMoves > 21
                routeOrigin := routePrice
                routeMoves := 0
                routeDirection := 0
    [routeDirection, routeMoves]

f_route_state_text(routeDirection) =>
    routeDirection == 1 ? "BULLISH" : routeDirection == -1 ? "BEARISH" : "SEARCHING"

f_route_alignment_text(routeDirection, parentDirection, hasParent) =>
    not hasParent ? "ROOT" : routeDirection == 0 or parentDirection == 0 ? "PENDING" : routeDirection == parentDirection ? "ALIGNED" : "DIVERGENT"

f_correction_ratios(startIndex, aCount, bCount, cCount) =>
    startPrice = array.get(swingPrices, startIndex)
    aPrice = array.get(swingPrices, startIndex + aCount)
    bPrice = array.get(swingPrices, startIndex + aCount + bCount)
    cPrice = array.get(swingPrices, startIndex + aCount + bCount + cCount)
    aLength = math.abs(aPrice - startPrice)
    bLength = math.abs(bPrice - aPrice)
    cLength = math.abs(cPrice - bPrice)
    [f_ratio(bLength, aLength), f_ratio(cLength, aLength), f_ratio(cLength, bLength)]

f_zig_channel_target(startIndex, aCount, bCount, terminalIndex) =>
    aIndex = startIndex + aCount
    bIndex = aIndex + bCount
    originPrice = array.get(swingPrices, startIndex)
    aPrice = array.get(swingPrices, aIndex)
    bPrice = array.get(swingPrices, bIndex)
    originBar = array.get(swingBars, startIndex)
    aBar = array.get(swingBars, aIndex)
    bBar = array.get(swingBars, bIndex)
    terminalBar = array.get(swingBars, terminalIndex)
    slope = f_ratio(bPrice - originPrice, math.max(1, bBar - originBar))
    aPrice + slope * (terminalBar - aBar)

f_flat_a_pass(pattern, startIndex, aCount, precedingLength) =>
    if pattern != "Flat"
        true
    else if aCount <= 0 or precedingLength <= 0
        false
    else
        aPrice = array.get(swingPrices, startIndex + aCount)
        startPrice = array.get(swingPrices, startIndex)
        math.abs(aPrice - startPrice) / precedingLength >= flatAMinRetrace

f_eval_simple_correction(startIndex, endIndex) =>
    confirmed = false
    primary = "Zig-Zag / Flat"
    alternate = ""
    selectedBRatio = float(na)
    internalPattern = "parallel candidates"
    reason = "C_INTERNAL_INCOMPLETE"
    selectedACount = 0
    selectedBCount = 0
    selectedCCount = 0
    selectedSubtype = "SIMPLE_CORRECTION_FORMING"
    sawBTimeFailure = false
    sawCTimeFailure = false
    if startIndex >= 0 and endIndex > startIndex
        for aOption = 0 to 4
            aCount = f_impulse_count(aOption)
            for bOption = 0 to 2
                bCount = f_correction_count_option(bOption)
                for cOption = 0 to 5
                    cCount = f_c_motive_count(cOption)
                    if startIndex + aCount + bCount + cCount == endIndex
                        [bRatio, cVsA, cVsB] = f_correction_ratios(startIndex, aCount, bCount, cCount)
                        aIndex = startIndex + aCount
                        bIndex = aIndex + bCount
                        aDuration = math.max(1, array.get(swingBars, aIndex) - array.get(swingBars, startIndex))
                        bDuration = math.max(1, array.get(swingBars, bIndex) - array.get(swingBars, aIndex))
                        cDuration = math.max(1, array.get(swingBars, endIndex) - array.get(swingBars, bIndex))
                        abDuration = aDuration + bDuration
                        bTimePass = math.abs(bDuration - aDuration) <= timeToleranceBars or math.abs(bDuration - 2.0 * aDuration) <= timeToleranceBars or math.abs(bDuration - 5.0 * aDuration) <= timeToleranceBars or math.abs(bDuration - 10.0 * aDuration) <= timeToleranceBars
                        cTimePass = math.abs(cDuration - 0.25 * abDuration) <= timeToleranceBars or math.abs(cDuration - 0.50 * abDuration) <= timeToleranceBars or math.abs(cDuration - abDuration) <= timeToleranceBars
                        zigPricePass = not na(bRatio) and bRatio >= 0.01 and bRatio <= 0.618 and not na(cVsA) and cVsA >= 0.618 and cVsA <= 4.618
                        [cDiagonalConfirmed, cDiagonalSubtype, cDiagonalReason, cDiagonalDivergence, cDiagonalPattern] = f_eval_diagonal(bIndex, endIndex, "ending")
                        cStructurePass = cCount != 15 or cDiagonalConfirmed
                        sawBTimeFailure := sawBTimeFailure or (zigPricePass and not bTimePass)
                        sawCTimeFailure := sawCTimeFailure or (zigPricePass and bTimePass and not cTimePass)
                        zigPass = zigPricePass and cStructurePass and bTimePass and cTimePass
                        if zigPass
                            if not confirmed
                                confirmed := true
                                primary := "Zig-Zag"
                                selectedSubtype := cVsA <= 1.618 ? "ZIG_ZAG_NORMAL" : "ZIG_ZAG_ELONGATED"
                                selectedBRatio := bRatio
                                [aDiagonalConfirmed, aDiagonalSubtype, aDiagonalReason, aDiagonalDivergence, aDiagonalPattern] = f_eval_diagonal(startIndex, aIndex, "leading")
                                internalPattern := (aDiagonalConfirmed ? "LD " : "") + str.tostring(aCount) + "-" + str.tostring(bCount) + "-" + str.tostring(cCount) + (cDiagonalConfirmed ? " ED" : "")
                                selectedACount := aCount
                                selectedBCount := bCount
                                selectedCCount := cCount
                                reason := "CORRECTION_CONFIRMED"
                            else
                                alternate := "Zig-Zag"
        for aOption = 0 to 2
            aCount = f_correction_count_option(aOption)
            for bOption = 0 to 2
                bCount = f_correction_count_option(bOption)
                for cOption = 0 to 5
                    cCount = f_c_motive_count(cOption)
                    if startIndex + aCount + bCount + cCount == endIndex
                        [bRatio, cVsA, cVsB] = f_correction_ratios(startIndex, aCount, bCount, cCount)
                        aIndex = startIndex + aCount
                        bIndex = aIndex + bCount
                        aDuration = math.max(1, array.get(swingBars, aIndex) - array.get(swingBars, startIndex))
                        bDuration = math.max(1, array.get(swingBars, bIndex) - array.get(swingBars, aIndex))
                        cDuration = math.max(1, array.get(swingBars, endIndex) - array.get(swingBars, bIndex))
                        abDuration = aDuration + bDuration
                        bTimePass = math.abs(bDuration - aDuration) <= timeToleranceBars or math.abs(bDuration - 2.0 * aDuration) <= timeToleranceBars or math.abs(bDuration - 5.0 * aDuration) <= timeToleranceBars or math.abs(bDuration - 10.0 * aDuration) <= timeToleranceBars
                        cTimePass = math.abs(cDuration - 0.25 * abDuration) <= timeToleranceBars or math.abs(cDuration - 0.50 * abDuration) <= timeToleranceBars or math.abs(cDuration - abDuration) <= timeToleranceBars
                        flatPricePass = not na(bRatio) and bRatio >= flatBMinRetrace and bRatio <= flatBMaxRetrace and not na(cVsA) and cVsA >= 0.618 and cVsA <= 2.618
                        [cDiagonalConfirmed, cDiagonalSubtype, cDiagonalReason, cDiagonalDivergence, cDiagonalPattern] = f_eval_diagonal(bIndex, endIndex, "ending")
                        cStructurePass = cCount != 15 or cDiagonalConfirmed
                        sawBTimeFailure := sawBTimeFailure or (flatPricePass and not bTimePass)
                        sawCTimeFailure := sawCTimeFailure or (flatPricePass and bTimePass and not cTimePass)
                        flatPass = flatPricePass and cStructurePass and bTimePass and cTimePass
                        if flatPass
                            if not confirmed
                                confirmed := true
                                primary := "Flat"
                                selectedSubtype := bRatio <= 0.812 ? (cVsA <= 1.618 ? "FLAT_NORMAL" : "FLAT_ELONGATED") : (cVsA <= 1.618 ? "FLAT_STRONG_IRREGULAR" : "FLAT_RUNNING")
                                selectedBRatio := bRatio
                                internalPattern := str.tostring(aCount) + "-" + str.tostring(bCount) + "-" + str.tostring(cCount) + (cDiagonalConfirmed ? " ED" : "")
                                selectedACount := aCount
                                selectedBCount := bCount
                                selectedCCount := cCount
                                reason := "CORRECTION_CONFIRMED"
                            else
                                alternate := "Flat"
        if not confirmed and endIndex - startIndex >= 6
            aPrice = array.get(swingPrices, startIndex + 3)
            bPrice = array.get(swingPrices, startIndex + 6)
            startPrice = array.get(swingPrices, startIndex)
            selectedBRatio := f_ratio(math.abs(bPrice - aPrice), math.abs(aPrice - startPrice))
            if not na(selectedBRatio) and selectedBRatio > flatBMaxRetrace
                reason := "FLAT_B_GT_111"
        if not confirmed and reason != "FLAT_B_GT_111"
            reason := sawBTimeFailure ? "B_TIME_GATE_FAIL" : sawCTimeFailure ? "C_TIME_GATE_FAIL" : reason
    [confirmed, primary, alternate, selectedSubtype, selectedBRatio, internalPattern, math.max(0, endIndex - startIndex), reason, selectedACount, selectedBCount, selectedCCount]

f_eval_triangle(startIndex, endIndex, requireBreak) =>
    confirmed = false
    foundStructure = false
    subtype = "TRIANGLE_FORMING"
    reason = "TRIANGLE_GEOMETRY_PENDING"
    internalPattern = "3/7/11 corrective legs"
    selectedA = 0
    selectedB = 0
    selectedC = 0
    selectedD = 0
    selectedE = 0
    thrustMin = float(na)
    thrustMax = float(na)
    terminalIndex = endIndex
    confirmationIndex = endIndex
    if startIndex >= 0 and endIndex > startIndex
        for aOption = 0 to 2
            aCount = f_correction_count_option(aOption)
            for bOption = 0 to 2
                bCount = f_correction_count_option(bOption)
                for cOption = 0 to 2
                    cCount = f_correction_count_option(cOption)
                    for dOption = 0 to 2
                        dCount = f_correction_count_option(dOption)
                        for eOption = 0 to 2
                            eCount = f_correction_count_option(eOption)
                            candidateTerminal = startIndex + aCount + bCount + cCount + dCount + eCount
                            if not foundStructure and candidateTerminal <= endIndex
                                aIndex = startIndex + aCount
                                bIndex = aIndex + bCount
                                cIndex = bIndex + cCount
                                dIndex = cIndex + dCount
                                eIndex = dIndex + eCount
                                p0 = array.get(swingPrices, startIndex)
                                pA = array.get(swingPrices, aIndex)
                                pB = array.get(swingPrices, bIndex)
                                pC = array.get(swingPrices, cIndex)
                                pD = array.get(swingPrices, dIndex)
                                pE = array.get(swingPrices, eIndex)
                                aLen = math.abs(pA - p0)
                                bLen = math.abs(pB - pA)
                                cLen = math.abs(pC - pB)
                                dLen = math.abs(pD - pC)
                                eLen = math.abs(pE - pD)
                                retracePasses = (bLen / aLen >= 0.50 ? 1 : 0) + (cLen / bLen >= 0.50 ? 1 : 0) + (dLen / cLen >= 0.50 ? 1 : 0) + (eLen / dLen >= 0.50 ? 1 : 0)
                                acSlope = f_ratio(pC - pA, math.max(1, array.get(swingBars, cIndex) - array.get(swingBars, aIndex)))
                                bdSlope = f_ratio(pD - pB, math.max(1, array.get(swingBars, dIndex) - array.get(swingBars, bIndex)))
                                opposite = not na(acSlope) and not na(bdSlope) and acSlope * bdSlope < 0
                                sameDirection = not na(acSlope) and not na(bdSlope) and acSlope * bdSlope > 0
                                contractingHorizontal = aLen > bLen and bLen > cLen and cLen > dLen and dLen > eLen and opposite
                                contractingIrregular = bLen > aLen and bLen > cLen and cLen > dLen and dLen > eLen and bLen <= 2.618 * aLen and opposite
                                contractingRunning = bLen > aLen and bLen > cLen and dLen > cLen and eLen < dLen and bLen >= math.max(math.max(aLen, cLen), math.max(dLen, eLen)) and sameDirection
                                expandingHorizontal = aLen <= math.min(math.min(bLen, cLen), math.min(dLen, eLen)) and aLen < bLen and bLen < cLen and cLen < dLen and dLen < eLen and opposite
                                expandingIrregular = bLen <= math.min(math.min(aLen, cLen), math.min(dLen, eLen)) and cLen > bLen and dLen > cLen and eLen > dLen and eLen >= math.max(math.max(aLen, bLen), math.max(cLen, dLen)) and opposite
                                expandingRunning = bLen > aLen and cLen < bLen and dLen > cLen and eLen > dLen and eLen >= math.max(math.max(aLen, bLen), math.max(cLen, dLen)) and sameDirection
                                shapePass = retracePasses >= 3 and (contractingHorizontal or contractingIrregular or contractingRunning or expandingHorizontal or expandingIrregular or expandingRunning)
                                if shapePass
                                    candidateSubtype = contractingHorizontal ? "HORIZONTAL_CONTRACTING" : contractingIrregular ? "IRREGULAR_CONTRACTING" : contractingRunning ? "RUNNING_CONTRACTING" : expandingHorizontal ? "HORIZONTAL_EXPANDING" : expandingIrregular ? "IRREGULAR_EXPANDING" : "RUNNING_EXPANDING"
                                    acTouches = 0
                                    bdTouches = 0
                                    aBar = array.get(swingBars, aIndex)
                                    bBar = array.get(swingBars, bIndex)
                                    cBar = array.get(swingBars, cIndex)
                                    dBar = array.get(swingBars, dIndex)
                                    eBar = array.get(swingBars, eIndex)
                                    for touchIndex = startIndex to eIndex
                                        touchBar = array.get(swingBars, touchIndex)
                                        touchPrice = array.get(swingPrices, touchIndex)
                                        touchTolerance = 0.25 * array.get(swingAtr, touchIndex)
                                        acValue = pA + acSlope * (touchBar - aBar)
                                        bdValue = pB + bdSlope * (touchBar - bBar)
                                        acTouches += math.abs(touchPrice - acValue) <= math.max(touchTolerance, 0.000000001) ? 1 : 0
                                        bdTouches += math.abs(touchPrice - bdValue) <= math.max(touchTolerance, 0.000000001) ? 1 : 0
                                    apexDenominator = acSlope - bdSlope
                                    apexPosition = math.abs(apexDenominator) > 0.000000000001 ? (pB - pA + acSlope * aBar - bdSlope * bBar) / apexDenominator : na
                                    longestDuration = math.max(math.max(aBar - array.get(swingBars, startIndex), bBar - aBar), math.max(math.max(cBar - bBar, dBar - cBar), eBar - dBar))
                                    apexPass = candidateSubtype != "HORIZONTAL_CONTRACTING" or (not na(apexPosition) and apexPosition >= eBar and apexPosition <= eBar + 0.618 * longestDuration)
                                    touchPass = acTouches <= 5 and bdTouches <= 5
                                    breakConfirmed = not requireBreak
                                    if requireBreak and endIndex > eIndex
                                        firstObservedBar = math.max(eBar + 1, bar_index - 4999)
                                        lastObservedBar = bar_index
                                        if lastObservedBar >= firstObservedBar
                                            for observedBar = firstObservedBar to lastObservedBar
                                                if not breakConfirmed
                                                    observedClose = close[bar_index - observedBar]
                                                    bdValue = pB + bdSlope * (observedBar - bBar)
                                                    breakConfirmed := array.get(swingTypes, eIndex) == -1 ? observedClose > bdValue : observedClose < bdValue
                                    if apexPass and touchPass
                                        foundStructure := true
                                        confirmed := breakConfirmed
                                        subtype := candidateSubtype
                                        reason := breakConfirmed ? "TRIANGLE_CONFIRMED" : "TRIANGLE_BD_BREAK_PENDING"
                                        terminalIndex := eIndex
                                        confirmationIndex := breakConfirmed ? endIndex : eIndex
                                    contracting = contractingHorizontal or contractingIrregular or contractingRunning
                                    widest = math.max(math.max(aLen, bLen), math.max(math.max(cLen, dLen), eLen))
                                    thrustBase = contracting ? widest : eLen
                                    thrustMin := (contracting ? 0.75 : 0.618) * thrustBase
                                    thrustMax := (contracting ? 1.25 : 1.0) * thrustBase
                                    internalPattern := str.tostring(aCount) + "-" + str.tostring(bCount) + "-" + str.tostring(cCount) + "-" + str.tostring(dCount) + "-" + str.tostring(eCount)
                                    selectedA := aCount
                                    selectedB := bCount
                                    selectedC := cCount
                                    selectedD := dCount
                                    selectedE := eCount
    [confirmed, subtype, internalPattern, math.max(0, terminalIndex - startIndex), reason, selectedA, selectedB, selectedC, selectedD, selectedE, thrustMin, thrustMax, terminalIndex, confirmationIndex]

f_duration_ratio(startIndex, endIndex, referenceStartIndex, referenceEndIndex) =>
    duration = math.max(1, array.get(swingBars, endIndex) - array.get(swingBars, startIndex))
    reference = math.max(1, array.get(swingBars, referenceEndIndex) - array.get(swingBars, referenceStartIndex))
    duration / reference

f_near_duration(observed, target) =>
    math.abs(observed - target) <= timeToleranceBars

f_complex_component_count(optionIndex) =>
    optionIndex == 0 ? 11 : optionIndex == 1 ? 13 : 15

f_connector_count(optionIndex) =>
    optionIndex == 0 ? 1 : optionIndex == 1 ? 3 : optionIndex == 2 ? 7 : 11

f_eval_component(startIndex, endIndex, allowTriangle) =>
    [simpleConfirmed, simplePrimary, simpleAlternate, simpleSubtype, simpleBRatio, simplePattern, simpleCount, simpleReason, simpleA, simpleB, simpleC] = f_eval_simple_correction(startIndex, endIndex)
    [triangleConfirmed, triangleSubtype, trianglePattern, triangleCount, triangleReason, triangleA, triangleB, triangleC, triangleD, triangleE, triangleThrustMin, triangleThrustMax, triangleTerminalIndex, triangleConfirmationIndex] = f_eval_triangle(startIndex, endIndex, false)
    useTriangle = allowTriangle and triangleConfirmed
    [useTriangle or simpleConfirmed, useTriangle ? "Triangle" : simplePrimary, useTriangle ? trianglePattern : simplePattern]

f_correction_rank(pattern) =>
    pattern == "W-X-Y-XX-Z" ? 12 : pattern == "W-X-Y" ? 8 : pattern == "Triangle" ? 7 : pattern == "Zig-Zag" or pattern == "Flat" ? 4 : 0

f_double_post_y_confirmation(startIndex, xIndex, yIndex, endIndex) =>
    confirmed = false
    confirmationIndex = yIndex
    confirmationMode = ""
    if endIndex > yIndex
        originPrice = array.get(swingPrices, startIndex)
        xPrice = array.get(swingPrices, xIndex)
        yPrice = array.get(swingPrices, yIndex)
        originBar = array.get(swingBars, startIndex)
        xBar = array.get(swingBars, xIndex)
        yBar = array.get(swingBars, yIndex)
        yDuration = math.max(1, yBar - xBar)
        deadline = yBar + yDuration
        wxyRange = math.abs(yPrice - originPrice)
        downward = yPrice < originPrice
        lineSlope = f_ratio(xPrice - originPrice, math.max(1, xBar - originBar))
        firstObservedBar = yBar + 1
        lastObservedBar = math.min(bar_index, deadline)
        if lastObservedBar >= firstObservedBar
            for observedBar = firstObservedBar to lastObservedBar
                if not confirmed
                    observedOffset = bar_index - observedBar
                    observedClose = close[observedOffset]
                    retrace = f_ratio(downward ? observedClose - yPrice : yPrice - observedClose, wxyRange)
                    lineValue = originPrice + lineSlope * (observedBar - originBar)
                    trendlineBreak = downward ? observedClose > lineValue : observedClose < lineValue
                    if trendlineBreak or (not na(retrace) and retrace >= 0.382)
                        confirmed := true
                        confirmationIndex := endIndex
                        confirmationMode := trendlineBreak ? "0-X_CLOSED_BREAK" : "WXY_38_2_RETRACE"
    [confirmed, confirmationIndex, confirmationMode]

f_eval_complex_correction(startIndex, endIndex, allowTriple) =>
    confirmed = false
    primary = "W-X-Y"
    subtype = "DOUBLE_FORMING"
    selectedXRatio = float(na)
    selectedYProjection = float(na)
    selectedXXRatio = float(na)
    selectedZProjection = float(na)
    internalPattern = "W + X + Y component containers"
    reason = "DOUBLE_COMPONENT_PENDING"
    selectedWCount = 0
    selectedXCount = 0
    selectedYCount = 0
    selectedXXCount = 0
    selectedZCount = 0
    terminalIndex = endIndex
    confirmationIndex = endIndex
    pendingFound = false
    if startIndex >= 0 and endIndex > startIndex
        for wOption = 0 to 2
            wCount = f_complex_component_count(wOption)
            wIndex = startIndex + wCount
            if wIndex < endIndex
                [wConfirmed, wPattern, wInternal] = f_eval_component(startIndex, wIndex, false)
                if wConfirmed
                    wLength = math.abs(array.get(swingPrices, wIndex) - array.get(swingPrices, startIndex))
                    wDuration = math.max(1, array.get(swingBars, wIndex) - array.get(swingBars, startIndex))
                    for xOption = 0 to 3
                        xCount = f_connector_count(xOption)
                        xIndex = wIndex + xCount
                        if xIndex < endIndex
                            xLength = math.abs(array.get(swingPrices, xIndex) - array.get(swingPrices, wIndex))
                            xRatio = f_ratio(xLength, wLength)
                            xSmall = not na(xRatio) and xRatio >= 0.142 and xRatio <= 0.50
                            xLarge = not na(xRatio) and xRatio >= 0.618 and xRatio <= 1.11
                            xDuration = math.max(1, array.get(swingBars, xIndex) - array.get(swingBars, wIndex))
                            xTimePass = xDuration < wDuration and (f_near_duration(xDuration, 0.25 * wDuration) or f_near_duration(xDuration, wDuration / 3.0) or f_near_duration(xDuration, 0.50 * wDuration))
                            if (xSmall or xLarge) and xTimePass
                                for yOption = 0 to 2
                                    yCount = f_complex_component_count(yOption)
                                    yIndex = xIndex + yCount
                                    if yIndex <= endIndex
                                        [yConfirmed, yPattern, yInternal] = f_eval_component(xIndex, yIndex, true)
                                        if yConfirmed
                                            yDuration = math.max(1, array.get(swingBars, yIndex) - array.get(swingBars, xIndex))
                                            yTimePass = f_near_duration(yDuration, wDuration) or f_near_duration(yDuration, wDuration + xDuration) or f_near_duration(yDuration, 0.50 * (wDuration + xDuration))
                                            yProjection = f_ratio(math.abs(array.get(swingPrices, yIndex) - array.get(swingPrices, xIndex)), wLength)
                                            yMax = wPattern == "Zig-Zag" and yPattern == "Triangle" ? 1.0 : wPattern == "Zig-Zag" and yPattern == "Zig-Zag" ? 2.618 : 1.618
                                            yPass = not na(yProjection) and yProjection >= 0.618 and yProjection <= yMax and yTimePass
                                            if yPass
                                                [postYConfirmed, postYIndex, postYMode] = f_double_post_y_confirmation(startIndex, xIndex, yIndex, endIndex)
                                                if postYConfirmed and not confirmed
                                                    confirmed := true
                                                    primary := "W-X-Y"
                                                    subtype := "DOUBLE_" + str.upper(str.replace_all(wPattern, "-", "_")) + "_" + str.upper(str.replace_all(yPattern, "-", "_"))
                                                    selectedXRatio := xRatio
                                                    selectedYProjection := yProjection
                                                    internalPattern := wInternal + " | X" + str.tostring(xCount) + " | " + yInternal
                                                    reason := "DOUBLE_CONFIRMED_" + postYMode
                                                    selectedWCount := wCount
                                                    selectedXCount := xCount
                                                    selectedYCount := yCount
                                                    terminalIndex := yIndex
                                                    confirmationIndex := postYIndex
                                                else if not pendingFound
                                                    pendingFound := true
                                                    primary := "W-X-Y"
                                                    subtype := "DOUBLE_FORMING"
                                                    selectedXRatio := xRatio
                                                    selectedYProjection := yProjection
                                                    internalPattern := wInternal + " | X" + str.tostring(xCount) + " | " + yInternal
                                                    reason := "DOUBLE_CONFIRMATION_PENDING"
                                                    selectedWCount := wCount
                                                    selectedXCount := xCount
                                                    selectedYCount := yCount
                                                    terminalIndex := yIndex
                                                    confirmationIndex := yIndex
        if allowTriple
            for wOption = 0 to 2
                wCount = f_complex_component_count(wOption)
                wIndex = startIndex + wCount
                if wIndex < endIndex
                    [wConfirmed, wPattern, wInternal] = f_eval_component(startIndex, wIndex, false)
                    if wConfirmed
                        wLength = math.abs(array.get(swingPrices, wIndex) - array.get(swingPrices, startIndex))
                        wDuration = math.max(1, array.get(swingBars, wIndex) - array.get(swingBars, startIndex))
                        for xOption = 0 to 3
                            xCount = f_connector_count(xOption)
                            xIndex = wIndex + xCount
                            if xIndex < endIndex
                                xLength = math.abs(array.get(swingPrices, xIndex) - array.get(swingPrices, wIndex))
                                xRatio = f_ratio(xLength, wLength)
                                xClassPass = not na(xRatio) and ((xRatio >= 0.142 and xRatio <= 0.50) or (xRatio >= 0.618 and xRatio <= 1.11))
                                xDuration = math.max(1, array.get(swingBars, xIndex) - array.get(swingBars, wIndex))
                                xTimePass = xDuration < wDuration and (f_near_duration(xDuration, 0.25 * wDuration) or f_near_duration(xDuration, wDuration / 3.0) or f_near_duration(xDuration, 0.50 * wDuration))
                                if xClassPass and xTimePass
                                    for yOption = 0 to 2
                                        yCount = f_complex_component_count(yOption)
                                        yIndex = xIndex + yCount
                                        if yIndex < endIndex
                                            [yConfirmed, yPattern, yInternal] = f_eval_component(xIndex, yIndex, true)
                                            if yConfirmed
                                                yLength = math.abs(array.get(swingPrices, yIndex) - array.get(swingPrices, xIndex))
                                                yProjection = f_ratio(yLength, wLength)
                                                yDuration = math.max(1, array.get(swingBars, yIndex) - array.get(swingBars, xIndex))
                                                yTimePass = f_near_duration(yDuration, wDuration) or f_near_duration(yDuration, wDuration + xDuration) or f_near_duration(yDuration, 0.50 * (wDuration + xDuration))
                                                if not na(yProjection) and yProjection >= 0.618 and yProjection <= 1.618 and yTimePass
                                                    for xxOption = 0 to 3
                                                        xxCount = f_connector_count(xxOption)
                                                        xxIndex = yIndex + xxCount
                                                        zCount = endIndex - xxIndex
                                                        zCountAllowed = zCount == 11 or zCount == 13 or zCount == 15
                                                        if xxIndex < endIndex and zCountAllowed
                                                            xxLength = math.abs(array.get(swingPrices, xxIndex) - array.get(swingPrices, yIndex))
                                                            xxRatio = f_ratio(xxLength, yLength)
                                                            xxDuration = math.max(1, array.get(swingBars, xxIndex) - array.get(swingBars, yIndex))
                                                            xIsHigh = array.get(swingTypes, xIndex) == 1
                                                            xBoundaryPass = xIsHigh ? array.get(swingPrices, xxIndex) <= array.get(swingPrices, xIndex) : array.get(swingPrices, xxIndex) >= array.get(swingPrices, xIndex)
                                                            xxPass = not na(xxRatio) and xxRatio >= 0.50 and xxRatio <= 0.618 and xBoundaryPass and f_near_duration(xxDuration, xDuration) and xxDuration < yDuration
                                                            [zConfirmed, zPattern, zInternal] = f_eval_component(xxIndex, endIndex, true)
                                                            zLength = math.abs(array.get(swingPrices, endIndex) - array.get(swingPrices, xxIndex))
                                                            zProjection = f_ratio(zLength, yLength)
                                                            zDuration = math.max(1, array.get(swingBars, endIndex) - array.get(swingBars, xxIndex))
                                                            zTimePass = f_near_duration(zDuration, yDuration) or f_near_duration(zDuration, yDuration + xxDuration) or f_near_duration(zDuration, 0.50 * (yDuration + xxDuration))
                                                            if xxPass and zConfirmed and not na(zProjection) and zProjection >= 0.618 and zProjection <= 1.618 and zTimePass
                                                                confirmed := true
                                                                primary := "W-X-Y-XX-Z"
                                                                subtype := "TRIPLE_COMPLETE"
                                                                selectedXRatio := xRatio
                                                                selectedYProjection := yProjection
                                                                selectedXXRatio := xxRatio
                                                                selectedZProjection := zProjection
                                                                internalPattern := wInternal + " | X" + str.tostring(xCount) + " | " + yInternal + " | XX" + str.tostring(xxCount) + " | " + zInternal
                                                                reason := "TRIPLE_CONFIRMED"
                                                                selectedWCount := wCount
                                                                selectedXCount := xCount
                                                                selectedYCount := yCount
                                                                selectedXXCount := xxCount
                                                                selectedZCount := zCount
                                                                terminalIndex := endIndex
                                                                confirmationIndex := endIndex
    [confirmed, primary, subtype, selectedXRatio, selectedYProjection, selectedXXRatio, selectedZProjection, internalPattern, math.max(0, terminalIndex - startIndex), reason, selectedWCount, selectedXCount, selectedYCount, selectedXXCount, selectedZCount, terminalIndex, confirmationIndex]

f_w2_time_pass(w1Duration, w2Duration) =>
    f_near_duration(w2Duration, 0.25 * w1Duration) or f_near_duration(w2Duration, 0.50 * w1Duration) or f_near_duration(w2Duration, w1Duration) or f_near_duration(w2Duration, 2.0 * w1Duration)

f_w3_time_pass(w1Duration, w2Duration, w3Duration) =>
    combined = w1Duration + w2Duration
    f_near_duration(w3Duration, 0.50 * combined) or f_near_duration(w3Duration, combined)

f_w4_time_pass(w2Duration, w3Duration, w4Duration) =>
    combined = w2Duration + w3Duration
    f_near_duration(w4Duration, 0.50 * w2Duration) or f_near_duration(w4Duration, 2.0 * w2Duration) or f_near_duration(w4Duration, 3.0 * w2Duration) or f_near_duration(w4Duration, 5.0 * w2Duration) or f_near_duration(w4Duration, 0.25 * combined) or f_near_duration(w4Duration, 0.50 * combined) or f_near_duration(w4Duration, combined)

f_w5_time_pass(w1Duration, w3Duration, w4Duration, w5Duration) =>
    combined13 = w1Duration + w3Duration
    f_near_duration(w5Duration, w1Duration) or f_near_duration(w5Duration, w4Duration) or f_near_duration(w5Duration, 0.25 * combined13) or f_near_duration(w5Duration, 0.50 * combined13) or f_near_duration(w5Duration, combined13) or f_near_duration(w5Duration, 0.50 * (w3Duration + w4Duration))

f_internal_four_overlaps_one(startIndex, endIndex, bullish) =>
    overlaps = false
    if endIndex - startIndex >= 5
        internalOne = array.get(swingPrices, startIndex + 1)
        internalFour = array.get(swingPrices, endIndex - 1)
        overlaps := bullish ? internalFour <= internalOne : internalFour >= internalOne
    overlaps

f_w2_minimum() =>
    wave2MinimumMode == "Chartking" ? wave2MinRetrace : 0.14

f_w4_minimum() =>
    wave4MinimumMode == "Chartking" ? wave4MinRetrace : 0.14

f_w3_maximum() =>
    wave3MaximumMode == "Chartking 2700%" ? 27.0 : 21.0

f_start_confirmation_note(cycleStart) =>
    note = ""
    startOk = wave1StartMode == "Off"
    if wave1StartMode != "Off" and array.size(swingPrices) > cycleStart + 1
        p0 = array.get(swingPrices, cycleStart)
        p1 = array.get(swingPrices, cycleStart + 1)
        atr0 = array.get(swingAtr, cycleStart)
        importantRange = array.get(swingImportantRange, cycleStart)
        wave1 = math.abs(p1 - p0)
        importantExtremeOk = array.get(swingImportantExtreme, cycleStart)
        degreeOk = not na(importantRange) and importantRange > 0 and wave1 >= importantRange * degreeRetrace
        atrOk = importantAtrMultiple <= 0 ? true : not na(atr0) and wave1 >= atr0 * importantAtrMultiple
        startType = array.get(swingTypes, cycleStart)
        bullishStart = p1 > p0
        directionOk = anchorDirection == "Auto" ? true : anchorDirection == "Bullish from important low" ? startType == -1 and bullishStart : startType == 1 and not bullishStart
        importantOk = directionOk and importantExtremeOk and degreeOk and atrOk
        macdExtremeOk = array.get(swingMacdExtreme, cycleStart)
        rsi0 = array.get(swingRsi, cycleStart)
        macd0 = array.get(swingMacdHist, cycleStart)
        prevSame = f_previous_same_type_index(cycleStart, startType)
        divergenceOk = false
        if prevSame >= 0
            prevPrice = array.get(swingPrices, prevSame)
            prevRsi = array.get(swingRsi, prevSame)
            prevMacd = array.get(swingMacdHist, prevSame)
            priceExtends = bullishStart ? p0 < prevPrice : p0 > prevPrice
            rsiDiverges = bullishStart ? rsi0 > prevRsi : rsi0 < prevRsi
            macdDiverges = bullishStart ? macd0 > prevMacd : macd0 < prevMacd
            divergenceOk := priceExtends and (rsiDiverges or macdDiverges)
        oscillatorOk = macdExtremeOk or divergenceOk
        startOk := wave1StartMode == "Important swing" ? importantOk : importantOk and oscillatorOk
        note := "Wave 1 start: direction " + (directionOk ? "OK" : "no") + ", Important H/L " + (importantExtremeOk ? "OK" : "no") + ", degree " + (degreeOk ? "OK" : "no") + ", ATR swing " + (atrOk ? "OK" : "weak") + ", MACD extreme " + (macdExtremeOk ? "OK" : "no") + ", RSI/MACD divergence " + (divergenceOk ? "OK" : "no")
    [startOk, note]

f_valid_anchor_index(index) =>
    anchor = -1
    if countDisplayMode == "All swings"
        anchor := 0
    else if index >= 0
        for j = 0 to index
            [startOk, anchorNote] = f_start_confirmation_note(j)
            if startOk
                anchor := j
    anchor

f_wave_phase(index) =>
    if countDisplayMode == "All swings"
        f_phase(index)
    else
        anchor = f_valid_anchor_index(index)
        anchor >= 0 ? (index - anchor) % f_cycle_length() : -1

f_passes_swing_filter(pivotPrice, lastPrice, pivotAtr, pivotImportantRange) =>
    distance = math.abs(pivotPrice - lastPrice)
    minByAtr = minSwingAtrMultiple > 0 and not na(pivotAtr) ? pivotAtr * minSwingAtrMultiple : 0.0
    minByRange = minSwingRangePct > 0 and not na(pivotImportantRange) ? pivotImportantRange * minSwingRangePct : 0.0
    distance >= math.max(minByAtr, minByRange)

f_upsert_swing(pivotBar, pivotPrice, pivotType, pivotAtr, pivotMacdHist, pivotRsi, pivotMacdExtreme, pivotImportantExtreme, pivotImportantRange, pivotImportantHigh, pivotImportantLow) =>
    changed = false
    count = array.size(swingBars)
    if count == 0
        array.push(swingBars, pivotBar)
        array.push(swingPrices, pivotPrice)
        array.push(swingTypes, pivotType)
        array.push(swingAtr, pivotAtr)
        array.push(swingMacdHist, pivotMacdHist)
        array.push(swingRsi, pivotRsi)
        array.push(swingMacdExtreme, pivotMacdExtreme)
        array.push(swingImportantExtreme, pivotImportantExtreme)
        array.push(swingImportantRange, pivotImportantRange)
        array.push(swingImportantHigh, pivotImportantHigh)
        array.push(swingImportantLow, pivotImportantLow)
        changed := true
    else
        lastType = array.get(swingTypes, count - 1)
        lastPrice = array.get(swingPrices, count - 1)
        if pivotType == lastType
            moreExtreme = pivotType == 1 ? pivotPrice > lastPrice : pivotPrice < lastPrice
            lastBar = array.get(swingBars, count - 1)
            lockedMainEndpoint = baseLocked and (lastBar == lockedW1Bar or lastBar == lockedW2Bar or lastBar == lockedW3Bar or lastBar == lockedW4Bar or lastBar == lockedW5Bar)
            if moreExtreme and not lockedMainEndpoint
                array.set(swingBars, count - 1, pivotBar)
                array.set(swingPrices, count - 1, pivotPrice)
                array.set(swingTypes, count - 1, pivotType)
                array.set(swingAtr, count - 1, pivotAtr)
                array.set(swingMacdHist, count - 1, pivotMacdHist)
                array.set(swingRsi, count - 1, pivotRsi)
                array.set(swingMacdExtreme, count - 1, pivotMacdExtreme)
                array.set(swingImportantExtreme, count - 1, pivotImportantExtreme)
                array.set(swingImportantRange, count - 1, pivotImportantRange)
                array.set(swingImportantHigh, count - 1, pivotImportantHigh)
                array.set(swingImportantLow, count - 1, pivotImportantLow)
                changed := true
        else if f_passes_swing_filter(pivotPrice, lastPrice, pivotAtr, pivotImportantRange)
            array.push(swingBars, pivotBar)
            array.push(swingPrices, pivotPrice)
            array.push(swingTypes, pivotType)
            array.push(swingAtr, pivotAtr)
            array.push(swingMacdHist, pivotMacdHist)
            array.push(swingRsi, pivotRsi)
            array.push(swingMacdExtreme, pivotMacdExtreme)
            array.push(swingImportantExtreme, pivotImportantExtreme)
            array.push(swingImportantRange, pivotImportantRange)
            array.push(swingImportantHigh, pivotImportantHigh)
            array.push(swingImportantLow, pivotImportantLow)
            while array.size(swingBars) > maxSwings
                array.shift(swingBars)
                array.shift(swingPrices)
                array.shift(swingTypes)
                array.shift(swingAtr)
                array.shift(swingMacdHist)
                array.shift(swingRsi)
                array.shift(swingMacdExtreme)
                array.shift(swingImportantExtreme)
                array.shift(swingImportantRange)
                array.shift(swingImportantHigh)
                array.shift(swingImportantLow)
            changed := true
    changed
f_rule_state(index, phase) =>
    hardInvalid = false
    softWarn = false
    note = ""
    cycleStart = index - phase
    wave4Phase = f_wave4_complete_phase()
    wave5Phase = f_wave5_phase()
    if showRuleWarnings and cycleStart >= 0
        if phase == 1 and index >= 1
            [startOk, startNote] = f_start_confirmation_note(cycleStart)
            softWarn := not startOk
            note := startNote
        if phase == 2 and index >= 2
            p0 = array.get(swingPrices, cycleStart)
            p1 = array.get(swingPrices, cycleStart + 1)
            p2 = array.get(swingPrices, cycleStart + 2)
            t0 = array.get(swingBars, cycleStart)
            t1 = array.get(swingBars, cycleStart + 1)
            t2 = array.get(swingBars, cycleStart + 2)
            bullish = p1 > p0
            wave1 = math.abs(p1 - p0)
            retrace = wave1 > 0 ? math.abs(p1 - p2) / wave1 : na
            time1 = math.max(1, t1 - t0)
            time2 = math.max(1, t2 - t1)
            hardInvalid := bullish ? p2 <= p0 : p2 >= p0
            softWarn := not hardInvalid and ((not na(retrace) and retrace < wave2MinRetrace) or time2 > time1 * wave2MaxTime)
            note := "Wave 2: retrace " + str.tostring(retrace * 100.0, "#.##") + "%, time x " + str.tostring(time2 / time1, "#.##")
        if phase == 3 and index >= 3
            p0 = array.get(swingPrices, cycleStart)
            p1 = array.get(swingPrices, cycleStart + 1)
            p2 = array.get(swingPrices, cycleStart + 2)
            p3 = array.get(swingPrices, cycleStart + 3)
            wave1 = math.abs(p1 - p0)
            wave3 = math.abs(p3 - p2)
            ratio = wave1 > 0 ? wave3 / wave1 : na
            softWarn := not na(ratio) and ratio < wave3MinExtension
            t0 = array.get(swingBars, cycleStart)
            t1 = array.get(swingBars, cycleStart + 1)
            t2 = array.get(swingBars, cycleStart + 2)
            t3 = array.get(swingBars, cycleStart + 3)
            time1 = math.max(1, t1 - t0)
            time2 = math.max(1, t2 - t1)
            time3 = math.max(1, t3 - t2)
            equal12 = math.abs(time1 - time2) <= time1 * 0.05
            expected3 = equal12 ? time1 + time2 : (time1 + time2) / 2.0
            timeWarn = expected3 > 0 and math.abs(time3 - expected3) / expected3 > timeTolerance
            softWarn := softWarn or timeWarn
            note := "Wave 3: " + str.tostring(ratio * 100.0, "#.##") + "% of Wave 1, time " + str.tostring(time3) + " bars vs rule " + str.tostring(expected3, "#.##")
        if showWave4Internal and phase == 4 and index >= 4
            p2 = array.get(swingPrices, cycleStart + 2)
            p3 = array.get(swingPrices, cycleStart + 3)
            pA = array.get(swingPrices, cycleStart + 4)
            wave3 = math.abs(p3 - p2)
            aRetrace = wave3 > 0 ? math.abs(p3 - pA) / wave3 : na
            softWarn := not na(aRetrace) and aRetrace < flatAMinRetrace
            note := "Wave 4 A: retrace " + str.tostring(aRetrace * 100.0, "#.##") + "% of W3, flat minimum " + str.tostring(flatAMinRetrace * 100.0, "#.##") + "%"
        if showWave4Internal and phase == 5 and index >= 5
            p3 = array.get(swingPrices, cycleStart + 3)
            pA = array.get(swingPrices, cycleStart + 4)
            pB = array.get(swingPrices, cycleStart + 5)
            aLength = math.abs(p3 - pA)
            bRetrace = aLength > 0 ? math.abs(pB - pA) / aLength : na
            softWarn := not na(bRetrace) and (bRetrace < flatBMinRetrace or bRetrace > flatBMaxRetrace)
            note := "B wave: " + str.tostring(bRetrace * 100.0, "#.##") + "% of A, flat range " + str.tostring(flatBMinRetrace * 100.0, "#.##") + "-" + str.tostring(flatBMaxRetrace * 100.0, "#.##") + "%"
        if phase == wave4Phase and index >= wave4Phase
            p1 = array.get(swingPrices, cycleStart + 1)
            p2 = array.get(swingPrices, cycleStart + 2)
            p3 = array.get(swingPrices, cycleStart + 3)
            p4 = array.get(swingPrices, cycleStart + wave4Phase)
            bullish = p3 > p2
            wave3 = math.abs(p3 - p2)
            retrace = wave3 > 0 ? math.abs(p3 - p4) / wave3 : na
            hardInvalid := bullish ? p4 <= p1 : p4 >= p1
            softWarn := not hardInvalid and not na(retrace) and (retrace < wave4MinRetrace or retrace > wave4MaxRetrace)
            t2 = array.get(swingBars, cycleStart + 2)
            t3 = array.get(swingBars, cycleStart + 3)
            t4 = array.get(swingBars, cycleStart + wave4Phase)
            time2 = math.max(1, t2 - array.get(swingBars, cycleStart + 1))
            time4 = math.max(1, t4 - t3)
            timeRatio4 = time4 / time2
            nearHalf = math.abs(timeRatio4 - 0.5) <= timeTolerance
            nearTwo = math.abs(timeRatio4 - 2.0) <= timeTolerance
            nearThree = math.abs(timeRatio4 - 3.0) <= timeTolerance
            timeWarn4 = not (nearHalf or nearTwo or nearThree)
            softWarn := softWarn or timeWarn4
            wave4Label = showWave4Internal ? "Wave 4/C" : "Wave 4"
            note := wave4Label + ": retrace " + str.tostring(retrace * 100.0, "#.##") + "%, time " + str.tostring(timeRatio4, "#.##") + "x W2, correction " + correctionPattern
        if phase == wave5Phase and index >= wave5Phase
            p0 = array.get(swingPrices, cycleStart)
            p1 = array.get(swingPrices, cycleStart + 1)
            p2 = array.get(swingPrices, cycleStart + 2)
            p3 = array.get(swingPrices, cycleStart + 3)
            p4 = array.get(swingPrices, cycleStart + wave4Phase)
            p5 = array.get(swingPrices, cycleStart + wave5Phase)
            wave1 = math.abs(p1 - p0)
            wave3 = math.abs(p3 - p2)
            wave5 = math.abs(p5 - p4)
            base = math.abs(p3 - p4)
            ratio = base > 0 ? wave5 / base : na
            hardInvalid := wave3 < wave1 and wave3 < wave5
            softWarn := not hardInvalid and not na(ratio) and (ratio < wave5MinExtension or ratio > wave5MaxExtension)
            note := "Wave 5: " + str.tostring(ratio * 100.0, "#.##") + "% of Wave 3-4"
    [hardInvalid, softWarn, note]
f_latest_time_note() =>
    note = "Waiting for Wave 2"
    state = "..."
    count = array.size(swingBars)
    if count >= 3
        latest = count - 1
        searchLimit = int(math.min(count - 3, 120))
        for offset = 0 to searchLimit
            i = latest - offset
            phase = f_wave_phase(i)
            if phase >= 2 and note == "Waiting for Wave 2"
                cycleStart = i - phase
                if cycleStart >= 0 and array.size(swingBars) > cycleStart + 2
                    t0 = array.get(swingBars, cycleStart)
                    t1 = array.get(swingBars, cycleStart + 1)
                    t2 = array.get(swingBars, cycleStart + 2)
                    time1 = math.max(1, t1 - t0)
                    time2 = math.max(1, t2 - t1)
                    ratio2 = time2 / time1
                    state := ratio2 <= wave2MaxTime ? "OK" : "WARN"
                    note := "W2 " + str.tostring(ratio2, "#.##") + "x W1 | rule 0.25/0.5/1/2x"
                    if phase >= 3 and array.size(swingBars) > cycleStart + 3
                        t3 = array.get(swingBars, cycleStart + 3)
                        time3 = math.max(1, t3 - t2)
                        equal12 = math.abs(time1 - time2) <= time1 * 0.05
                        expected3 = equal12 ? time1 + time2 : (time1 + time2) / 2.0
                        ratio3 = expected3 > 0 ? time3 / expected3 : na
                        state := not na(ratio3) and math.abs(ratio3 - 1.0) <= timeTolerance ? "OK" : "WARN"
                        note := "W3 " + str.tostring(time3) + " bars | rule " + str.tostring(expected3, "#.##")
                    wave4Phase = f_wave4_complete_phase()
                    if phase >= wave4Phase and array.size(swingBars) > cycleStart + wave4Phase
                        t3 = array.get(swingBars, cycleStart + 3)
                        t4 = array.get(swingBars, cycleStart + wave4Phase)
                        time4 = math.max(1, t4 - t3)
                        ratio4 = time4 / time2
                        nearHalf = math.abs(ratio4 - 0.5) <= timeTolerance
                        nearTwo = math.abs(ratio4 - 2.0) <= timeTolerance
                        nearThree = math.abs(ratio4 - 3.0) <= timeTolerance
                        state := nearHalf or nearTwo or nearThree ? "OK" : "WARN"
                        note := "W4 " + str.tostring(ratio4, "#.##") + "x W2 | rule 0.5/2/3x"
    [state, note]

f_update_time_table() =>
    if showTimeTable and barstate.islast
        if f_is_candidate_mode()
            stateColor = candidateState == "CONFIRMED" ? color.new(color.green, 0) : candidateState == "INVALID" ? color.new(color.red, 0) : color.new(color.orange, 0)
            fibEvidence = str.length(currentFibAnchor) > 0 and not na(currentFibValue) ? currentFibAnchor + " " + str.tostring(currentFibValue * 100.0, "#.##") + "%" : "waiting"
            patternEvidence = str.length(alternatePattern) > 0 ? primaryPattern + " | alt " + alternatePattern : primaryPattern
            routedConfidence = not na(currentConfidence) ? math.min(100.0, currentConfidence + routeConfidenceBonus) : na
            supportEvidence = (not na(currentTimeValue) ? " | time x" + str.tostring(currentTimeValue, "#.##") : "") + (str.length(currentMacdState) > 0 ? " | " + currentMacdState : "") + (str.length(hpSignalState) > 0 ? " | " + hpSignalState : "") + (str.length(currentChannelState) > 0 ? " | " + currentChannelState : "") + (str.length(currentTargetCluster) > 0 ? " | " + currentTargetCluster : "") + (str.length(fbdCandidateState) > 0 ? " | " + fbdCandidateState : "") + (not na(routedConfidence) ? " | confidence " + str.tostring(routedConfidence, "#") : "")
            table.cell(timeTable, 0, 0, engineMode == "Candidate State (V4 Full Cycle)" ? "EW V4" : "EW Phase 1", text_color=color.white, bgcolor=color.new(color.black, 0))
            table.cell(timeTable, 1, 0, candidateState, text_color=color.white, bgcolor=stateColor)
            table.cell(timeTable, 0, 1, "Degree", text_color=color.white, bgcolor=color.new(color.black, 15))
            table.cell(timeTable, 1, 1, degreeName + " / " + degreeSourceTimeframe, text_color=color.white, bgcolor=color.new(color.black, 15))
            table.cell(timeTable, 0, 2, "Parent state", text_color=color.white, bgcolor=color.new(color.black, 15))
            table.cell(timeTable, 1, 2, engineStage + (baseLocked ? " | P0 " + str.tostring(lockedBasePrice, format.mintick) : ""), text_color=color.white, bgcolor=color.new(color.black, 15))
            table.cell(timeTable, 0, 3, "Pattern", text_color=color.white, bgcolor=color.new(color.black, 15))
            table.cell(timeTable, 1, 3, str.length(patternEvidence) > 0 ? patternEvidence : "waiting", text_color=color.white, bgcolor=color.new(color.black, 15))
            table.cell(timeTable, 0, 4, "Evidence", text_color=color.white, bgcolor=color.new(color.black, 15))
            table.cell(timeTable, 1, 4, fibEvidence + (str.length(currentInternalPattern) > 0 ? " | " + currentInternalPattern : "") + supportEvidence, text_color=color.white, bgcolor=color.new(color.black, 15))
            table.cell(timeTable, 0, 5, "Reason / recount", text_color=color.white, bgcolor=color.new(color.black, 15))
            table.cell(timeTable, 1, 5, lastReasonCode + " | " + str.tostring(recountCount) + "/" + str.tostring(alternateBaseCount), text_color=color.white, bgcolor=color.new(color.black, 15))
            table.cell(timeTable, 0, 6, "Next", text_color=color.white, bgcolor=color.new(color.black, 15))
            table.cell(timeTable, 1, 6, currentNextCondition, text_color=color.white, bgcolor=color.new(color.black, 15))
        else
            [state, note] = f_latest_time_note()
            table.cell(timeTable, 0, 0, "EW Time", text_color=color.white, bgcolor=color.new(color.black, 0))
            table.cell(timeTable, 1, 0, state, text_color=color.white, bgcolor=state == "WARN" ? color.new(color.orange, 0) : color.new(color.green, 0))
            table.cell(timeTable, 0, 1, "Rule", text_color=color.white, bgcolor=color.new(color.black, 15))
            table.cell(timeTable, 1, 1, "Wave 2 <= " + str.tostring(wave2MaxTime, "#.##") + "x Wave 1", text_color=color.white, bgcolor=color.new(color.black, 15))
            table.cell(timeTable, 0, 2, "Latest", text_color=color.white, bgcolor=color.new(color.black, 15))
            table.cell(timeTable, 1, 2, note, text_color=color.white, bgcolor=color.new(color.black, 15))
            table.cell(timeTable, 0, 3, "Correction", text_color=color.white, bgcolor=color.new(color.black, 15))
            table.cell(timeTable, 1, 3, correctionPattern, text_color=color.white, bgcolor=color.new(color.black, 15))
            for row = 4 to 6
                table.cell(timeTable, 0, row, "", bgcolor=color.new(color.black, 100))
                table.cell(timeTable, 1, row, "", bgcolor=color.new(color.black, 100))
    else if not showTimeTable and barstate.islast
        table.clear(timeTable, 0, 0, 1, 6)

f_label_color(phase, hardInvalid, softWarn) =>
    if hardInvalid
        color.new(color.red, 0)
    else if softWarn
        color.new(color.orange, 0)
    else if f_is_impulse_phase(phase)
        color.new(color.black, 0)
    else
        color.new(color.teal, 0)


f_fib_ratio(index) =>
    index == 0 ? 0.0 : index == 1 ? 0.14 : index == 2 ? 0.236 : index == 3 ? 0.382 : index == 4 ? 0.5 : index == 5 ? 0.618 : index == 6 ? 0.812 : index == 7 ? 1.0 : index == 8 ? 1.11 : 1.272

f_fib_text(index) =>
    index == 0 ? "0.00%" : index == 1 ? "14.00%" : index == 2 ? "23.60%" : index == 3 ? "38.20%" : index == 4 ? "50.00%" : index == 5 ? "61.80%" : index == 6 ? "81.20%" : index == 7 ? "100.00%" : index == 8 ? "111.00%" : "127.20%"

f_anchor_fib_price(anchorIndex, ratio) =>
    importantHigh = array.get(swingImportantHigh, anchorIndex)
    importantLow = array.get(swingImportantLow, anchorIndex)
    importantRange = importantHigh - importantLow
    anchorType = array.get(swingTypes, anchorIndex)
    not na(importantRange) and importantRange > 0 ? (anchorType == -1 ? importantLow + importantRange * ratio : importantHigh - importantRange * ratio) : na

f_draw_anchor_fib(anchorIndex) =>
    if showAnchorFib and anchorIndex >= 0 and array.size(swingBars) > anchorIndex
        anchorBar = array.get(swingBars, anchorIndex)
        for fibIndex = 0 to 9
            ratio = f_fib_ratio(fibIndex)
            price = f_anchor_fib_price(anchorIndex, ratio)
            if not na(price)
                opacity = ratio == 0.0 or ratio == 1.0 ? 35 : 55
                ln = line.new(anchorBar, price, bar_index, price, extend=extend.right, color=color.new(fibLineColor, opacity), width=1)
                lb = label.new(bar_index, price, text=f_fib_text(fibIndex) + " (" + str.tostring(price, format.mintick) + ")", style=label.style_label_left, yloc=yloc.price, color=color.new(color.white, 100), textcolor=fibLineColor, size=size.tiny)
                array.push(anchorFibLines, ln)
                array.push(anchorFibLabels, lb)

f_draw_wave5_targets(cycleStart) =>
    wave4Phase = f_wave4_complete_phase()
    if showTargets and cycleStart >= 0 and array.size(swingPrices) > cycleStart + wave4Phase
        p3 = array.get(swingPrices, cycleStart + 3)
        p4 = array.get(swingPrices, cycleStart + wave4Phase)
        b4 = array.get(swingBars, cycleStart + wave4Phase)
        bullish = p3 > p4
        base = math.abs(p3 - p4)
        minTarget = bullish ? p4 + base * wave5MinExtension : p4 - base * wave5MinExtension
        maxTarget = bullish ? p4 + base * wave5MaxExtension : p4 - base * wave5MaxExtension
        minLine = line.new(b4, minTarget, bar_index, minTarget, extend=extend.right, color=color.new(color.green, 45), style=line.style_dashed)
        maxLine = line.new(b4, maxTarget, bar_index, maxTarget, extend=extend.right, color=color.new(color.green, 70), style=line.style_dotted)
        array.push(targetLines, minLine)
        array.push(targetLines, maxLine)

f_draw_locked_fib() =>
    importantRange = lockedImportantHigh - lockedImportantLow
    if showAnchorFib and baseLocked and not na(importantRange) and importantRange > 0
        for fibIndex = 0 to 9
            ratio = f_fib_ratio(fibIndex)
            price = lockedBullish ? lockedImportantLow + importantRange * ratio : lockedImportantHigh - importantRange * ratio
            opacity = ratio == 0.0 or ratio == 1.0 ? 35 : 55
            ln = line.new(lockedBaseBar, price, bar_index, price, extend=extend.right, color=color.new(fibLineColor, opacity), width=1)
            lb = label.new(bar_index, price, text=f_fib_text(fibIndex) + " (" + str.tostring(price, format.mintick) + ")", style=label.style_label_left, yloc=yloc.price, color=color.new(color.white, 100), textcolor=fibLineColor, size=size.tiny)
            array.push(anchorFibLines, ln)
            array.push(anchorFibLabels, lb)

f_redraw_candidate() =>
    f_clear_drawings()
    if baseLocked
        ln = line.new(lockedBaseBar, lockedBasePrice, lockedW1Bar, lockedW1Price, color=impulseLineColor, width=3)
        array.push(drawnLines, ln)
        baseStyle = lockedBullish ? label.style_label_up : label.style_label_down
        w1Style = lockedBullish ? label.style_label_down : label.style_label_up
        baseLabel = label.new(lockedBaseBar, lockedBasePrice, text="0", style=baseStyle, yloc=yloc.price, color=color.new(color.black, 0), textcolor=labelTextColor, size=f_label_size(), tooltip="Locked Point 0. It changes only after a hard origin invalidation.")
        w1Tooltip = "CONFIRMED | " + str.tostring(lockedInternalCount) + " internal moves | degree " + str.tostring(lockedDegreeProgress * 100.0, "#.##") + "%"
        w1Label = label.new(lockedW1Bar, lockedW1Price, text="1", style=w1Style, yloc=yloc.price, color=color.new(color.black, 0), textcolor=labelTextColor, size=f_label_size(), tooltip=w1Tooltip)
        array.push(drawnLabels, baseLabel)
        array.push(drawnLabels, w1Label)
        if not na(lockedW2Bar)
            w2Line = line.new(lockedW1Bar, lockedW1Price, lockedW2Bar, lockedW2Price, color=correctionLineColor, width=3)
            w2Style = lockedBullish ? label.style_label_up : label.style_label_down
            w2Label = label.new(lockedW2Bar, lockedW2Price, text="2", style=w2Style, yloc=yloc.price, color=color.new(color.teal, 0), textcolor=labelTextColor, size=f_label_size(), tooltip=lockedW2Pattern + " | " + lockedW2Subtype + " | retrace " + str.tostring(lockedW2Retrace * 100.0, "#.##") + "%")
            array.push(drawnLines, w2Line)
            array.push(drawnLabels, w2Label)
        if not na(lockedW3Bar)
            w3Line = line.new(lockedW2Bar, lockedW2Price, lockedW3Bar, lockedW3Price, color=impulseLineColor, width=3)
            w3Style = lockedBullish ? label.style_label_down : label.style_label_up
            w3Label = label.new(lockedW3Bar, lockedW3Price, text="3", style=w3Style, yloc=yloc.price, color=color.new(color.black, 0), textcolor=labelTextColor, size=f_label_size(), tooltip=lockedW3Subtype + " | W1 projection " + str.tostring(lockedW3Ratio * 100.0, "#.##") + "%")
            array.push(drawnLines, w3Line)
            array.push(drawnLabels, w3Label)
        if not na(lockedW4Bar)
            w4Line = line.new(lockedW3Bar, lockedW3Price, lockedW4Bar, lockedW4Price, color=correctionLineColor, width=3)
            w4Style = lockedBullish ? label.style_label_up : label.style_label_down
            w4Label = label.new(lockedW4Bar, lockedW4Price, text="4", style=w4Style, yloc=yloc.price, color=color.new(color.teal, 0), textcolor=labelTextColor, size=f_label_size(), tooltip=lockedW4Pattern + " | retrace " + str.tostring(lockedW4Retrace * 100.0, "#.##") + "%")
            array.push(drawnLines, w4Line)
            array.push(drawnLabels, w4Label)
            channelSlope = f_ratio(lockedW4Price - lockedW2Price, math.max(1, lockedW4Bar - lockedW2Bar))
            channelParallelAtW4 = lockedW3Price + channelSlope * (lockedW4Bar - lockedW3Bar)
            channel24 = line.new(lockedW2Bar, lockedW2Price, lockedW4Bar, lockedW4Price, extend=extend.right, color=color.new(color.blue, 45), style=line.style_dashed)
            channel3 = line.new(lockedW3Bar, lockedW3Price, lockedW4Bar, channelParallelAtW4, extend=extend.right, color=color.new(color.blue, 25), style=line.style_dashed)
            array.push(channelLines, channel24)
            array.push(channelLines, channel3)
            if showTargets
                targetBase = math.abs(lockedW3Price - lockedW4Price)
                targetMin = lockedBullish ? lockedW4Price + targetBase * wave5MinExtension : lockedW4Price - targetBase * wave5MinExtension
                targetMax = lockedBullish ? lockedW4Price + targetBase * wave5MaxExtension : lockedW4Price - targetBase * wave5MaxExtension
                targetMinLine = line.new(lockedW4Bar, targetMin, bar_index, targetMin, extend=extend.right, color=color.new(color.green, 45), style=line.style_dashed)
                targetMaxLine = line.new(lockedW4Bar, targetMax, bar_index, targetMax, extend=extend.right, color=color.new(color.green, 70), style=line.style_dotted)
                array.push(targetLines, targetMinLine)
                array.push(targetLines, targetMaxLine)
        if not na(lockedW5Bar)
            w5Line = line.new(lockedW4Bar, lockedW4Price, lockedW5Bar, lockedW5Price, color=impulseLineColor, width=3)
            w5Style = lockedBullish ? label.style_label_down : label.style_label_up
            w5Label = label.new(lockedW5Bar, lockedW5Price, text="5", style=w5Style, yloc=yloc.price, color=color.new(color.black, 0), textcolor=labelTextColor, size=f_label_size(), tooltip=lockedW5Subtype + " | 3-4 projection " + str.tostring(lockedW5Ratio * 100.0, "#.##") + "%")
            array.push(drawnLines, w5Line)
            array.push(drawnLabels, w5Label)
        if not na(lockedABar)
            aLine = line.new(lockedW5Bar, lockedW5Price, lockedABar, lockedAPrice, color=correctionLineColor, width=3)
            aStyle = lockedBullish ? label.style_label_up : label.style_label_down
            aLabel = label.new(lockedABar, lockedAPrice, text=f_locked_correction_label(0), style=aStyle, yloc=yloc.price, color=color.new(color.teal, 0), textcolor=labelTextColor, size=f_label_size(), tooltip=lockedCorrectionPattern + " | confirmed component pivot")
            array.push(drawnLines, aLine)
            array.push(drawnLabels, aLabel)
        if not na(lockedBBar)
            bLine = line.new(lockedABar, lockedAPrice, lockedBBar, lockedBPrice, color=correctionLineColor, width=3)
            bStyle = lockedBullish ? label.style_label_down : label.style_label_up
            bLabel = label.new(lockedBBar, lockedBPrice, text=f_locked_correction_label(1), style=bStyle, yloc=yloc.price, color=color.new(color.teal, 0), textcolor=labelTextColor, size=f_label_size(), tooltip=lockedCorrectionPattern + " | confirmed component pivot")
            array.push(drawnLines, bLine)
            array.push(drawnLabels, bLabel)
        if not na(lockedCBar)
            cLine = line.new(lockedBBar, lockedBPrice, lockedCBar, lockedCPrice, color=correctionLineColor, width=3)
            cStyle = lockedBullish ? label.style_label_up : label.style_label_down
            cLabel = label.new(lockedCBar, lockedCPrice, text=f_locked_correction_label(2), style=cStyle, yloc=yloc.price, color=color.new(color.teal, 0), textcolor=labelTextColor, size=f_label_size(), tooltip=lockedCorrectionPattern + " | component complete")
            array.push(drawnLines, cLine)
            array.push(drawnLabels, cLabel)
            if str.contains(lockedCorrectionPattern, "Zig-Zag")
                zigSlope = f_ratio(lockedBPrice - lockedW5Price, math.max(1, lockedBBar - lockedW5Bar))
                zigParallelAtC = lockedAPrice + zigSlope * (lockedCBar - lockedABar)
                zig0B = line.new(lockedW5Bar, lockedW5Price, lockedBBar, lockedBPrice, extend=extend.right, color=color.new(color.purple, 45), style=line.style_dashed)
                zigA = line.new(lockedABar, lockedAPrice, lockedCBar, zigParallelAtC, extend=extend.right, color=color.new(color.purple, 25), style=line.style_dashed)
                array.push(channelLines, zig0B)
                array.push(channelLines, zigA)
        if not na(lockedDBar)
            dLine = line.new(lockedCBar, lockedCPrice, lockedDBar, lockedDPrice, color=correctionLineColor, width=3)
            dStyle = lockedBullish ? label.style_label_down : label.style_label_up
            dLabel = label.new(lockedDBar, lockedDPrice, text=f_locked_correction_label(3), style=dStyle, yloc=yloc.price, color=color.new(color.teal, 0), textcolor=labelTextColor, size=f_label_size(), tooltip=lockedCorrectionPattern + " | confirmed component pivot")
            array.push(drawnLines, dLine)
            array.push(drawnLabels, dLabel)
        if not na(lockedEBar)
            eLine = line.new(lockedDBar, lockedDPrice, lockedEBar, lockedEPrice, color=correctionLineColor, width=3)
            eStyle = lockedBullish ? label.style_label_up : label.style_label_down
            eLabel = label.new(lockedEBar, lockedEPrice, text=f_locked_correction_label(4), style=eStyle, yloc=yloc.price, color=color.new(color.teal, 0), textcolor=labelTextColor, size=f_label_size(), tooltip=lockedCorrectionPattern + " | correction complete")
            array.push(drawnLines, eLine)
            array.push(drawnLabels, eLabel)
        if not na(lockedTriangleTargetNear) and not na(lockedTriangleTargetFar)
            triangleAnchorBar = not na(lockedEBar) ? lockedEBar : lockedW4Bar
            triangleNearLine = line.new(triangleAnchorBar, lockedTriangleTargetNear, bar_index, lockedTriangleTargetNear, extend=extend.right, color=color.new(color.green, 25), style=line.style_dashed)
            triangleFarLine = line.new(triangleAnchorBar, lockedTriangleTargetFar, bar_index, lockedTriangleTargetFar, extend=extend.right, color=color.new(color.green, 55), style=line.style_dotted)
            triangleInvalidLine = line.new(triangleAnchorBar, lockedTriangleInvalidation, bar_index, lockedTriangleInvalidation, extend=extend.right, color=color.new(color.red, 35), style=line.style_dotted)
            array.push(targetLines, triangleNearLine)
            array.push(targetLines, triangleFarLine)
            array.push(targetLines, triangleInvalidLine)
        f_draw_locked_fib()
        if showDevelopingCandidates and str.length(developingText) > 0 and array.size(swingBars) > 0
            latestIndex = array.size(swingBars) - 1
            latestBar = array.get(swingBars, latestIndex)
            lastLockedBar = not na(lockedEBar) ? lockedEBar : not na(lockedCBar) ? lockedCBar : not na(lockedW5Bar) ? lockedW5Bar : not na(lockedW4Bar) ? lockedW4Bar : not na(lockedW3Bar) ? lockedW3Bar : not na(lockedW2Bar) ? lockedW2Bar : lockedW1Bar
            if latestBar != lastLockedBar
                latestPrice = array.get(swingPrices, latestIndex)
                latestType = array.get(swingTypes, latestIndex)
                latestStyle = latestType == 1 ? label.style_label_down : label.style_label_up
                candidateLabel = label.new(latestBar, latestPrice, text=developingText, style=latestStyle, yloc=yloc.price, color=color.new(color.gray, 35), textcolor=color.white, size=size.tiny, tooltip="Developing raw pivot. It is promoted only after its parent-state rules pass.")
                array.push(drawnLabels, candidateLabel)
    if not na(lastInvalidBar)
        invalidLabel = label.new(lastInvalidBar, lastInvalidPrice, text="INVALID\nrecount " + str.tostring(recountCount), style=label.style_label_down, yloc=yloc.price, color=color.new(color.red, 0), textcolor=color.white, size=size.tiny, tooltip="W2_ORIGIN_BREAK: the locked Point 0 was crossed and released.")
        array.push(drawnLabels, invalidLabel)

f_redraw() =>
    f_clear_drawings()
    count = array.size(swingBars)
    if count > 0
        latestAnchor = f_valid_anchor_index(count - 1)
        f_draw_anchor_fib(latestAnchor)
        for i = 0 to count - 1
            b = array.get(swingBars, i)
            p = array.get(swingPrices, i)
            t = array.get(swingTypes, i)
            phase = f_wave_phase(i)
            cycleStart = phase >= 0 ? i - phase : -1
            if phase >= 0
                if i > 0
                    prevPhase = f_wave_phase(i - 1)
                    prevCycleStart = prevPhase >= 0 ? (i - 1) - prevPhase : -1
                    if prevPhase >= 0 and prevCycleStart == cycleStart
                        prevBar = array.get(swingBars, i - 1)
                        prevPrice = array.get(swingPrices, i - 1)
                        lineColor = f_is_impulse_phase(phase) ? impulseLineColor : correctionLineColor
                        ln = line.new(prevBar, prevPrice, b, p, color=lineColor, width=2)
                        array.push(drawnLines, ln)
                if showZero or phase != 0
                    [hardInvalid, softWarn, note] = f_rule_state(i, phase)
                    style = t == 1 ? label.style_label_down : label.style_label_up
                    lbl = label.new(b, p, text=f_phase_text(phase), style=style, yloc=yloc.price, color=f_label_color(phase, hardInvalid, softWarn), textcolor=labelTextColor, size=f_label_size(), tooltip=note)
                    array.push(drawnLabels, lbl)
                if phase == f_wave4_complete_phase()
                    f_draw_wave5_targets(cycleStart)
pivotHigh = ta.pivothigh(high, pivotLeft, pivotRight)
pivotLow = ta.pivotlow(low, pivotLeft, pivotRight)
pivotBar = bar_index - pivotRight
atrValue = ta.atr(importantAtrLength)
rsiValue = ta.rsi(close, rsiLength)
macdLine = ta.ema(close, macdFast) - ta.ema(close, macdSlow)
macdSignalLine = ta.ema(macdLine, macdSignal)
macdHist = macdLine - macdSignalLine
pivotAtr = atrValue[pivotRight]
pivotRsi = rsiValue[pivotRight]
pivotMacdHist = macdHist[pivotRight]
[routeMDir, routeMMoves] = request.security(syminfo.tickerid, "M", f_degree_route_snapshot(2), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[routeWDir, routeWMoves] = request.security(syminfo.tickerid, "W", f_degree_route_snapshot(3), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[routeDDir, routeDMoves] = request.security(syminfo.tickerid, "D", f_degree_route_snapshot(5), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[route288Dir, route288Moves] = request.security(syminfo.tickerid, "288", f_degree_route_snapshot(5), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[route240Dir, route240Moves] = request.security(syminfo.tickerid, "240", f_degree_route_snapshot(5), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[route60Dir, route60Moves] = request.security(syminfo.tickerid, "60", f_degree_route_snapshot(7), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[route15Dir, route15Moves] = request.security(syminfo.tickerid, "15", f_degree_route_snapshot(9), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[route5Dir, route5Moves] = request.security(syminfo.tickerid, "5", f_degree_route_snapshot(12), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[route3Dir, route3Moves] = request.security(syminfo.tickerid, "3", f_degree_route_snapshot(15), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
routeParentAligned = timeframe.period == "W" ? routeWDir != 0 and routeWDir == routeMDir : timeframe.period == "D" ? routeDDir != 0 and routeDDir == routeWDir : timeframe.period == "288" ? route288Dir != 0 and route288Dir == routeDDir : timeframe.period == "240" ? route240Dir != 0 and route240Dir == routeDDir : timeframe.period == "60" ? route60Dir != 0 and route60Dir == route240Dir : timeframe.period == "15" ? route15Dir != 0 and route15Dir == route60Dir : timeframe.period == "5" ? route5Dir != 0 and route5Dir == route15Dir : timeframe.period == "3" ? route3Dir != 0 and route3Dir == route5Dir : false
routeConfidenceBonus := routeParentAligned ? 5.0 : 0.0

degreeImportantHigh = request.security(syminfo.tickerid, degreeSourceTimeframe, ta.highest(high, importantLookbackDays), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
degreeImportantLow = request.security(syminfo.tickerid, degreeSourceTimeframe, ta.lowest(low, importantLookbackDays), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
importantHighSeries = f_is_candidate_mode() ? degreeImportantHigh : ta.highest(high, importantLookback)
importantLowSeries = f_is_candidate_mode() ? degreeImportantLow : ta.lowest(low, importantLookback)
importantHighAtPivot = importantHighSeries[pivotRight]
importantLowAtPivot = importantLowSeries[pivotRight]
importantRangeAtPivot = importantHighAtPivot - importantLowAtPivot
highIsImportant = pivotHigh >= importantHighAtPivot
lowIsImportant = pivotLow <= importantLowAtPivot
macdLowestAtPivot = pivotMacdHist <= ta.lowest(macdHist, oscillatorLookback)[pivotRight]
macdHighestAtPivot = pivotMacdHist >= ta.highest(macdHist, oscillatorLookback)[pivotRight]
changed = false

if not na(pivotHigh) and not na(pivotLow)
    lastPrice = array.size(swingPrices) > 0 ? array.get(swingPrices, array.size(swingPrices) - 1) : close[pivotRight]
    useHigh = math.abs(pivotHigh - lastPrice) >= math.abs(pivotLow - lastPrice)
    changed := useHigh ? f_upsert_swing(pivotBar, pivotHigh, 1, pivotAtr, pivotMacdHist, pivotRsi, macdHighestAtPivot, highIsImportant, importantRangeAtPivot, importantHighAtPivot, importantLowAtPivot) : f_upsert_swing(pivotBar, pivotLow, -1, pivotAtr, pivotMacdHist, pivotRsi, macdLowestAtPivot, lowIsImportant, importantRangeAtPivot, importantHighAtPivot, importantLowAtPivot)
else if not na(pivotHigh)
    changed := f_upsert_swing(pivotBar, pivotHigh, 1, pivotAtr, pivotMacdHist, pivotRsi, macdHighestAtPivot, highIsImportant, importantRangeAtPivot, importantHighAtPivot, importantLowAtPivot)
else if not na(pivotLow)
    changed := f_upsert_swing(pivotBar, pivotLow, -1, pivotAtr, pivotMacdHist, pivotRsi, macdLowestAtPivot, lowIsImportant, importantRangeAtPivot, importantHighAtPivot, importantLowAtPivot)

originProtected = engineStage == "W2_CORRECTION_CONTAINER" or engineStage == "W3_FORMING" or engineStage == "W4_CORRECTION_CONTAINER" or engineStage == "W5_FORMING"
originBroken = f_is_candidate_mode() and baseLocked and originProtected and bar_index > lockedAtBar and (lockedBullish ? low <= lockedBasePrice : high >= lockedBasePrice)
if originBroken
    baseLocked := false
    candidateState := "INVALID"
    lastReasonCode := "W2_ORIGIN_BREAK"
    recountCount += 1
    searchFloorBar := bar_index
    lastInvalidBar := bar_index
    lastInvalidPrice := lockedBullish ? low : high
    developingText := ""
    lockedBaseBar := na
    lockedBasePrice := na
    lockedW1Bar := na
    lockedW1Price := na
    lockedAtBar := na
    lockedDegreeProgress := na
    lockedInternalCount := na
    lockedW1Subtype := ""
    currentConfidence := na
    currentChannelState := ""
    currentChannelTarget := na
    currentTargetCluster := ""
    fbdCandidateState := ""
    lockedImportantHigh := na
    lockedImportantLow := na
    engineStage := "SEARCHING"
    primaryPattern := ""
    alternatePattern := ""
    currentFibAnchor := ""
    currentFibValue := na
    currentTimeValue := na
    currentInternalPattern := ""
    currentInternalCount := 0
    currentMacdState := ""
    currentNextCondition := "Need qualified Point 0 and Wave 1"
    hpSignalState := ""
    lockedW2Bar := na
    lockedW2Price := na
    lockedW2Pattern := ""
    lockedW2Subtype := ""
    lockedW2InternalCount := 0
    lockedW2Retrace := na
    lockedW3Bar := na
    lockedW3Price := na
    lockedW3Subtype := ""
    lockedW3InternalCount := 0
    lockedW3Ratio := na
    lockedW3Macd := na
    lockedW4Bar := na
    lockedW4Price := na
    lockedW4Pattern := ""
    lockedW4Retrace := na
    lockedW5Bar := na
    lockedW5Price := na
    lockedW5Subtype := ""
    lockedW5Ratio := na
    lockedABar := na
    lockedAPrice := na
    lockedBBar := na
    lockedBPrice := na
    lockedCBar := na
    lockedCPrice := na
    lockedDBar := na
    lockedDPrice := na
    lockedEBar := na
    lockedEPrice := na
    lockedCorrectionPattern := ""
    lockedTriangleTargetNear := na
    lockedTriangleTargetFar := na
    lockedTriangleInvalidation := na
    f_redraw_candidate()

if changed
    if f_is_candidate_mode()
        if baseLocked
            latestIndex = array.size(swingBars) - 1
            latestBar = array.get(swingBars, latestIndex)
            latestPrice = array.get(swingPrices, latestIndex)
            latestType = array.get(swingTypes, latestIndex)
            baseType = lockedBullish ? -1 : 1
            sameAsBase = latestType == baseType
            latestImportant = array.get(swingImportantExtreme, latestIndex)
            [latestOscillatorOk, latestExtreme, latestDivergence] = f_candidate_oscillator(latestIndex, lockedBullish)
            isAlternate = sameAsBase and latestImportant and latestOscillatorOk
            if engineMode == "Candidate State (Phase 1)"
                if isAlternate
                    alternateBaseCount += 1
                    candidateState := "ALTERNATE"
                    lastReasonCode := "LOCKED_BASE_ALTERNATE"
                    alternatePattern := "Alternate base"
                    developingText := "Alt 0"
                else
                    candidateState := "FORMING"
                    lastReasonCode := "W2_CLASSIFIER_PENDING"
                    primaryPattern := "Correction container"
                    currentNextCondition := "Need a valid W2 correction completion while Point 0 remains intact."
                    developingText := sameAsBase ? "2?" : "raw"
            else
                transitionConfirmed = false
                alternatePattern := ""
                hpSignalState := ""
                if engineStage == "W2_CORRECTION_CONTAINER"
                    w1Index = f_index_for_bar(lockedW1Bar)
                    if w1Index >= 0 and latestIndex > w1Index
                        [correctionConfirmed, correctionPrimary, correctionAlternate, correctionSubtype, bRatio, internalPattern, internalCount, correctionReason, correctionACount, correctionBCount, correctionCCount] = f_eval_simple_correction(w1Index, latestIndex)
