//@version=6
indicator("Elliott Wave Notes Overlay", overlay=true, max_lines_count=500, max_labels_count=500)

// Source notes:
// - EW Notes / Chartking material
// - EWT cheat sheet
// - Rules & Guidelines Summary EW Theory
// - Time analysis notes
// - Elliott Wave Master Developer Implementation Bible v2
//
// Candidate State is the default Phase-1/P0 engine. Legacy fixed-cycle mode is
// retained only for comparison while the later classifiers are implemented.

groupEngine = "Engine / Degree"
engineMode = input.string("Candidate State (Phase 1)", "Engine mode", options=["Candidate State (Phase 1)", "Legacy fixed cycle"], group=groupEngine)
degreePreset = input.string("Chartking Day Trading", "Degree preset", options=["Chartking Day Trading", "Hardik 1Y", "Hardik Swing", "Hardik Day Trading", "Manual"], group=groupEngine)
manualDegreeTimeframe = input.timeframe("D", "Manual Important H/L timeframe", group=groupEngine)
importantLookbackDays = input.int(144, "Important H/L source bars", minval=10, group=groupEngine, tooltip="Default uses 144 Daily source candles, not 144 local chart candles.")
baseOscillatorMode = input.string("Extreme or divergence", "Base oscillator rule", options=["Extreme or divergence", "Extreme only", "Divergence only", "Extreme and divergence", "Off"], group=groupEngine)
showDevelopingCandidates = input.bool(true, "Show developing/alternate status", group=groupEngine)
degreeSourceTimeframe = degreePreset == "Manual" ? manualDegreeTimeframe : degreePreset == "Hardik 1Y" ? "M" : "D"
degreeName = degreePreset == "Hardik 1Y" ? "Primary" : degreePreset == "Hardik Swing" ? "Intermediate" : "Major"

groupSwing = "Swing Detection"
pivotLeft = input.int(5, "Pivot left", minval=1, group=groupSwing)
pivotRight = input.int(5, "Pivot right", minval=1, group=groupSwing)
maxSwings = input.int(45, "Maximum swings to draw", minval=9, maxval=120, group=groupSwing)
minSwingAtrMultiple = input.float(1.5, "Minimum swing ATR multiple", minval=0.0, step=0.1, group=groupSwing)
minSwingRangePct = input.float(3.0, "Minimum swing % of Important H/L", minval=0.0, step=0.1, group=groupSwing) / 100.0
showZero = input.bool(false, "Show 0 labels", group=groupSwing)

groupStart = "Wave 1 Start"
wave1StartMode = input.string("Important swing + oscillator", "Start filter", options=["Off", "Important swing", "Important swing + oscillator"], group=groupStart)
anchorDirection = input.string("Auto", "Anchor direction", options=["Auto", "Bullish from important low", "Bearish from important high"], group=groupStart)
importantAtrLength = input.int(14, "Important swing ATR length", minval=1, group=groupStart)
importantAtrMultiple = input.float(1.0, "Important swing ATR multiple", minval=0.0, step=0.1, group=groupStart)
rsiLength = input.int(14, "RSI length", minval=1, group=groupStart)
macdFast = input.int(12, "MACD fast", minval=1, group=groupStart)
macdSlow = input.int(26, "MACD slow", minval=1, group=groupStart)
macdSignal = input.int(9, "MACD signal", minval=1, group=groupStart)
oscillatorLookback = input.int(100, "MACD extreme lookback", minval=5, group=groupStart)
importantLookback = input.int(144, "Legacy Important H/L chart bars", minval=10, group=groupStart)
degreeRetrace = input.float(61.8, "Degree retracement % of Important H/L", minval=1.0, step=0.1, group=groupStart) / 100.0

groupRules = "EW Notes Rules"
showRuleWarnings = input.bool(true, "Color rule warnings", group=groupRules)
wave2MinRetrace = input.float(14.0, "Wave 2 minimum retrace %", minval=0.0, step=0.1, group=groupRules) / 100.0
wave2MaxTime = input.float(2.0, "Wave 2 maximum time x Wave 1", minval=0.1, step=0.1, group=groupRules)
wave3MinExtension = input.float(161.8, "Wave 3 expected minimum % of Wave 1", minval=1.0, step=0.1, group=groupRules) / 100.0
wave4MinRetrace = input.float(14.0, "Wave 4 minimum retrace %", minval=0.0, step=0.1, group=groupRules) / 100.0
wave4MaxRetrace = input.float(50.0, "Wave 4 usual maximum retrace %", minval=0.0, step=0.1, group=groupRules) / 100.0
flatAMaxRetrace = input.float(61.8, "Flat A maximum retrace %", minval=0.0, step=0.1, group=groupRules) / 100.0
flatBMinRetrace = input.float(61.8, "Flat B minimum retrace %", minval=0.0, step=0.1, group=groupRules) / 100.0
flatBMaxRetrace = input.float(111.0, "Flat B maximum retrace %", minval=1.0, step=0.1, group=groupRules) / 100.0
wave5MinExtension = input.float(127.0, "Wave 5 minimum % of Wave 3-4", minval=1.0, step=0.1, group=groupRules) / 100.0
wave5MaxExtension = input.float(261.8, "Wave 5 maximum % of Wave 3-4", minval=1.0, step=0.1, group=groupRules) / 100.0
timeTolerance = input.float(25.0, "Time rule tolerance %", minval=0.0, step=1.0, group=groupRules) / 100.0

groupDisplay = "Display"
correctionPattern = input.string("A-B-C", "Correction labels", options=["A-B-C", "W-X-Y", "W-X-Y-X-Z", "A-B-C-D-E"], group=groupDisplay)
showWave4Internal = input.bool(true, "Show Wave 4 internal A/B/C", group=groupDisplay)
countDisplayMode = input.string("Validated Anchor", "Count mode", options=["Validated Anchor", "All swings"], group=groupDisplay)
showTargets = input.bool(true, "Show Wave 5 target zone", group=groupDisplay)
showAnchorFib = input.bool(true, "Show Important H/L fib guide", group=groupDisplay)
showTimeTable = input.bool(true, "Show time rules table", group=groupDisplay)
impulseLineColor = input.color(color.rgb(255, 128, 0), "Impulse line", group=groupDisplay)
correctionLineColor = input.color(color.rgb(0, 160, 160), "Correction line", group=groupDisplay)
fibLineColor = input.color(color.rgb(0, 80, 255), "Important H/L fib", group=groupDisplay)
labelTextColor = input.color(color.white, "Label text", group=groupDisplay)
labelSizeInput = input.string("small", "Label size", options=["tiny", "small", "normal"], group=groupDisplay)

var swingBars = array.new_int()
var swingPrices = array.new_float()
var swingTypes = array.new_int()
var swingAtr = array.new_float()
var swingMacdHist = array.new_float()
var swingRsi = array.new_float()
var swingMacdExtreme = array.new_bool()
var swingImportantExtreme = array.new_bool()
var swingImportantRange = array.new_float()
var swingImportantHigh = array.new_float()
var swingImportantLow = array.new_float()
var drawnLines = array.new_line()
var drawnLabels = array.new_label()
var targetLines = array.new_line()
var anchorFibLines = array.new_line()
var anchorFibLabels = array.new_label()
var table timeTable = table.new(position.top_right, 2, 7, border_width=1)

// Phase-1 candidate lifecycle. Confirmed values are copied out of the raw
// swing arrays so later same-side raw pivot replacements cannot move 0 or 1.
var string candidateState = "SEARCHING"
var string lastReasonCode = "SEARCHING_FOR_BASE"
var bool baseLocked = false
var bool lockedBullish = false
var int lockedBaseBar = na
var float lockedBasePrice = na
var int lockedW1Bar = na
var float lockedW1Price = na
var int lockedAtBar = na
var float lockedDegreeProgress = na
var int lockedInternalCount = na
var float lockedImportantHigh = na
var float lockedImportantLow = na
var int searchFloorBar = -1
var int recountCount = 0
var int alternateBaseCount = 0
var int lastInvalidBar = na
var float lastInvalidPrice = na
var string developingText = ""

f_label_size() =>
    labelSizeInput == "tiny" ? size.tiny : labelSizeInput == "normal" ? size.normal : size.small

f_correction_count() =>
    correctionPattern == "W-X-Y-X-Z" or correctionPattern == "A-B-C-D-E" ? 5 : 3

f_cycle_length() =>
    (showWave4Internal ? 8 : 6) + f_correction_count()

f_phase(index) =>
    index % f_cycle_length()

f_correction_text(offset) =>
    if correctionPattern == "W-X-Y"
        offset == 0 ? "W" : offset == 1 ? "X" : "Y"
    else if correctionPattern == "W-X-Y-X-Z"
        offset == 0 ? "W" : offset == 1 ? "X" : offset == 2 ? "Y" : offset == 3 ? "X" : "Z"
    else if correctionPattern == "A-B-C-D-E"
        offset == 0 ? "(A)" : offset == 1 ? "(B)" : offset == 2 ? "(C)" : offset == 3 ? "(D)" : "(E)"
    else
        offset == 0 ? "(A)" : offset == 1 ? "(B)" : "(C)"

f_phase_text(phase) =>
    if showWave4Internal
        phase <= 3 ? (phase == 0 ? "0" : str.tostring(phase)) : phase == 4 ? "(A)" : phase == 5 ? "(B)" : phase == 6 ? "4\n(C)" : phase == 7 ? "5" : f_correction_text(phase - 8)
    else
        phase <= 5 ? (phase == 0 ? "0" : str.tostring(phase)) : f_correction_text(phase - 6)

f_is_impulse_phase(phase) =>
    showWave4Internal ? (phase <= 3 or phase == 7) : phase <= 5

f_wave4_complete_phase() =>
    showWave4Internal ? 6 : 4

f_wave5_phase() =>
    showWave4Internal ? 7 : 5
f_clear_drawings() =>
    if array.size(drawnLines) > 0
        for i = 0 to array.size(drawnLines) - 1
            line.delete(array.get(drawnLines, i))
    if array.size(drawnLabels) > 0
        for i = 0 to array.size(drawnLabels) - 1
            label.delete(array.get(drawnLabels, i))
    if array.size(targetLines) > 0
        for i = 0 to array.size(targetLines) - 1
            line.delete(array.get(targetLines, i))
    if array.size(anchorFibLines) > 0
        for i = 0 to array.size(anchorFibLines) - 1
            line.delete(array.get(anchorFibLines, i))
    if array.size(anchorFibLabels) > 0
        for i = 0 to array.size(anchorFibLabels) - 1
            label.delete(array.get(anchorFibLabels, i))
    array.clear(drawnLines)
    array.clear(drawnLabels)
    array.clear(targetLines)
    array.clear(anchorFibLines)
    array.clear(anchorFibLabels)
f_previous_same_type_index(index, pivotType) =>
    found = -1
    if index > 0
        for j = 0 to index - 1
            checkIndex = index - 1 - j
            if found == -1 and array.get(swingTypes, checkIndex) == pivotType
                found := checkIndex
    found

f_candidate_oscillator(startIndex, bullish) =>
    extremeOk = array.get(swingMacdExtreme, startIndex)
    divergenceOk = false
    startType = array.get(swingTypes, startIndex)
    previousIndex = f_previous_same_type_index(startIndex, startType)
    if previousIndex >= 0
        startPrice = array.get(swingPrices, startIndex)
        previousPrice = array.get(swingPrices, previousIndex)
        startRsi = array.get(swingRsi, startIndex)
        previousRsi = array.get(swingRsi, previousIndex)
        startMacd = array.get(swingMacdHist, startIndex)
        previousMacd = array.get(swingMacdHist, previousIndex)
        priceExtends = bullish ? startPrice < previousPrice : startPrice > previousPrice
        rsiDiverges = bullish ? startRsi > previousRsi : startRsi < previousRsi
        macdDiverges = bullish ? startMacd > previousMacd : startMacd < previousMacd
        divergenceOk := priceExtends and (rsiDiverges or macdDiverges)
    oscillatorOk = baseOscillatorMode == "Off" ? true : baseOscillatorMode == "Extreme only" ? extremeOk : baseOscillatorMode == "Divergence only" ? divergenceOk : baseOscillatorMode == "Extreme and divergence" ? extremeOk and divergenceOk : extremeOk or divergenceOk
    [oscillatorOk, extremeOk, divergenceOk]

f_candidate_crosses_origin(startIndex, endIndex, bullish) =>
    crossed = false
    basePrice = array.get(swingPrices, startIndex)
    if endIndex > startIndex
        for checkIndex = startIndex + 1 to endIndex
            checkType = array.get(swingTypes, checkIndex)
            checkPrice = array.get(swingPrices, checkIndex)
            if bullish and checkType == -1 and checkPrice <= basePrice
                crossed := true
            if not bullish and checkType == 1 and checkPrice >= basePrice
                crossed := true
    crossed

f_candidate_for_count(endIndex, internalCount) =>
    startIndex = endIndex - internalCount
    valid = false
    progress = float(na)
    bullish = false
    note = ""
    if startIndex >= 0
        startBar = array.get(swingBars, startIndex)
        startPrice = array.get(swingPrices, startIndex)
        endPrice = array.get(swingPrices, endIndex)
        startType = array.get(swingTypes, startIndex)
        endType = array.get(swingTypes, endIndex)
        bullish := startType == -1 and endType == 1 and endPrice > startPrice
        bearish = startType == 1 and endType == -1 and endPrice < startPrice
        directionOk = anchorDirection == "Auto" ? true : anchorDirection == "Bullish from important low" ? bullish : bearish
        importantOk = wave1StartMode == "Off" or array.get(swingImportantExtreme, startIndex)
        importantRange = array.get(swingImportantRange, startIndex)
        distance = math.abs(endPrice - startPrice)
        progress := not na(importantRange) and importantRange > 0 ? distance / importantRange : na
        degreeOk = not na(progress) and progress >= degreeRetrace
        startAtr = array.get(swingAtr, startIndex)
        atrOk = importantAtrMultiple <= 0 or not na(startAtr) and distance >= startAtr * importantAtrMultiple
        [oscillatorEvidence, extremeOk, divergenceOk] = f_candidate_oscillator(startIndex, bullish)
        oscillatorOk = wave1StartMode == "Important swing" ? true : oscillatorEvidence
        originOk = not f_candidate_crosses_origin(startIndex, endIndex, bullish)
        floorOk = startBar >= searchFloorBar
        valid := (bullish or bearish) and directionOk and importantOk and degreeOk and atrOk and oscillatorOk and originOk and floorOk
        note := "W1 " + str.tostring(internalCount) + " moves | degree " + str.tostring(progress * 100.0, "#.##") + "% | extreme " + (extremeOk ? "yes" : "no") + " | divergence " + (divergenceOk ? "yes" : "no")
    [valid, startIndex, bullish, progress, note]

f_find_phase1_candidate() =>
    endIndex = array.size(swingBars) - 1
    foundStart = -1
    foundBullish = false
    foundProgress = float(na)
    foundCount = -1
    foundNote = ""
    if endIndex >= 5
        for countIndex = 0 to 4
            internalCount = countIndex == 0 ? 5 : countIndex == 1 ? 9 : countIndex == 2 ? 13 : countIndex == 3 ? 17 : 21
            [valid, startIndex, bullish, progress, note] = f_candidate_for_count(endIndex, internalCount)
            if foundStart == -1 and valid
                foundStart := startIndex
                foundBullish := bullish
                foundProgress := progress
                foundCount := internalCount
                foundNote := note
    [foundStart, endIndex, foundBullish, foundProgress, foundCount, foundNote]

f_start_confirmation_note(cycleStart) =>
    note = ""
    startOk = wave1StartMode == "Off"
    if wave1StartMode != "Off" and array.size(swingPrices) > cycleStart + 1
        p0 = array.get(swingPrices, cycleStart)
        p1 = array.get(swingPrices, cycleStart + 1)
        atr0 = array.get(swingAtr, cycleStart)
        importantRange = array.get(swingImportantRange, cycleStart)
        wave1 = math.abs(p1 - p0)
        importantExtremeOk = array.get(swingImportantExtreme, cycleStart)
        degreeOk = not na(importantRange) and importantRange > 0 and wave1 >= importantRange * degreeRetrace
        atrOk = importantAtrMultiple <= 0 ? true : not na(atr0) and wave1 >= atr0 * importantAtrMultiple
        startType = array.get(swingTypes, cycleStart)
        bullishStart = p1 > p0
        directionOk = anchorDirection == "Auto" ? true : anchorDirection == "Bullish from important low" ? startType == -1 and bullishStart : startType == 1 and not bullishStart
        importantOk = directionOk and importantExtremeOk and degreeOk and atrOk
        macdExtremeOk = array.get(swingMacdExtreme, cycleStart)
        rsi0 = array.get(swingRsi, cycleStart)
        macd0 = array.get(swingMacdHist, cycleStart)
        prevSame = f_previous_same_type_index(cycleStart, startType)
        divergenceOk = false
        if prevSame >= 0
            prevPrice = array.get(swingPrices, prevSame)
            prevRsi = array.get(swingRsi, prevSame)
            prevMacd = array.get(swingMacdHist, prevSame)
            priceExtends = bullishStart ? p0 < prevPrice : p0 > prevPrice
            rsiDiverges = bullishStart ? rsi0 > prevRsi : rsi0 < prevRsi
            macdDiverges = bullishStart ? macd0 > prevMacd : macd0 < prevMacd
            divergenceOk := priceExtends and (rsiDiverges or macdDiverges)
        oscillatorOk = macdExtremeOk or divergenceOk
        startOk := wave1StartMode == "Important swing" ? importantOk : importantOk and oscillatorOk
        note := "Wave 1 start: direction " + (directionOk ? "OK" : "no") + ", Important H/L " + (importantExtremeOk ? "OK" : "no") + ", degree " + (degreeOk ? "OK" : "no") + ", ATR swing " + (atrOk ? "OK" : "weak") + ", MACD extreme " + (macdExtremeOk ? "OK" : "no") + ", RSI/MACD divergence " + (divergenceOk ? "OK" : "no")
    [startOk, note]

f_valid_anchor_index(index) =>
    anchor = -1
    if countDisplayMode == "All swings"
        anchor := 0
    else if index >= 0
        for j = 0 to index
            [startOk, anchorNote] = f_start_confirmation_note(j)
            if startOk
                anchor := j
    anchor

f_wave_phase(index) =>
    if countDisplayMode == "All swings"
        f_phase(index)
    else
        anchor = f_valid_anchor_index(index)
        anchor >= 0 ? (index - anchor) % f_cycle_length() : -1

f_passes_swing_filter(pivotPrice, lastPrice, pivotAtr, pivotImportantRange) =>
    distance = math.abs(pivotPrice - lastPrice)
    minByAtr = minSwingAtrMultiple > 0 and not na(pivotAtr) ? pivotAtr * minSwingAtrMultiple : 0.0
    minByRange = minSwingRangePct > 0 and not na(pivotImportantRange) ? pivotImportantRange * minSwingRangePct : 0.0
    distance >= math.max(minByAtr, minByRange)

f_upsert_swing(pivotBar, pivotPrice, pivotType, pivotAtr, pivotMacdHist, pivotRsi, pivotMacdExtreme, pivotImportantExtreme, pivotImportantRange, pivotImportantHigh, pivotImportantLow) =>
    changed = false
    count = array.size(swingBars)
    if count == 0
        array.push(swingBars, pivotBar)
        array.push(swingPrices, pivotPrice)
        array.push(swingTypes, pivotType)
        array.push(swingAtr, pivotAtr)
        array.push(swingMacdHist, pivotMacdHist)
        array.push(swingRsi, pivotRsi)
        array.push(swingMacdExtreme, pivotMacdExtreme)
        array.push(swingImportantExtreme, pivotImportantExtreme)
        array.push(swingImportantRange, pivotImportantRange)
        array.push(swingImportantHigh, pivotImportantHigh)
        array.push(swingImportantLow, pivotImportantLow)
        changed := true
    else
        lastType = array.get(swingTypes, count - 1)
        lastPrice = array.get(swingPrices, count - 1)
        if pivotType == lastType
            moreExtreme = pivotType == 1 ? pivotPrice > lastPrice : pivotPrice < lastPrice
            if moreExtreme
                array.set(swingBars, count - 1, pivotBar)
                array.set(swingPrices, count - 1, pivotPrice)
                array.set(swingTypes, count - 1, pivotType)
                array.set(swingAtr, count - 1, pivotAtr)
                array.set(swingMacdHist, count - 1, pivotMacdHist)
                array.set(swingRsi, count - 1, pivotRsi)
                array.set(swingMacdExtreme, count - 1, pivotMacdExtreme)
                array.set(swingImportantExtreme, count - 1, pivotImportantExtreme)
                array.set(swingImportantRange, count - 1, pivotImportantRange)
                array.set(swingImportantHigh, count - 1, pivotImportantHigh)
                array.set(swingImportantLow, count - 1, pivotImportantLow)
                changed := true
        else if f_passes_swing_filter(pivotPrice, lastPrice, pivotAtr, pivotImportantRange)
            array.push(swingBars, pivotBar)
            array.push(swingPrices, pivotPrice)
            array.push(swingTypes, pivotType)
            array.push(swingAtr, pivotAtr)
            array.push(swingMacdHist, pivotMacdHist)
            array.push(swingRsi, pivotRsi)
            array.push(swingMacdExtreme, pivotMacdExtreme)
            array.push(swingImportantExtreme, pivotImportantExtreme)
            array.push(swingImportantRange, pivotImportantRange)
            array.push(swingImportantHigh, pivotImportantHigh)
            array.push(swingImportantLow, pivotImportantLow)
            while array.size(swingBars) > maxSwings
                array.shift(swingBars)
                array.shift(swingPrices)
                array.shift(swingTypes)
                array.shift(swingAtr)
                array.shift(swingMacdHist)
                array.shift(swingRsi)
                array.shift(swingMacdExtreme)
                array.shift(swingImportantExtreme)
                array.shift(swingImportantRange)
                array.shift(swingImportantHigh)
                array.shift(swingImportantLow)
            changed := true
    changed
f_rule_state(index, phase) =>
    hardInvalid = false
    softWarn = false
    note = ""
    cycleStart = index - phase
    wave4Phase = f_wave4_complete_phase()
    wave5Phase = f_wave5_phase()
    if showRuleWarnings and cycleStart >= 0
        if phase == 1 and index >= 1
            [startOk, startNote] = f_start_confirmation_note(cycleStart)
            softWarn := not startOk
            note := startNote
        if phase == 2 and index >= 2
            p0 = array.get(swingPrices, cycleStart)
            p1 = array.get(swingPrices, cycleStart + 1)
            p2 = array.get(swingPrices, cycleStart + 2)
            t0 = array.get(swingBars, cycleStart)
            t1 = array.get(swingBars, cycleStart + 1)
            t2 = array.get(swingBars, cycleStart + 2)
            bullish = p1 > p0
            wave1 = math.abs(p1 - p0)
            retrace = wave1 > 0 ? math.abs(p1 - p2) / wave1 : na
            time1 = math.max(1, t1 - t0)
            time2 = math.max(1, t2 - t1)
            hardInvalid := bullish ? p2 <= p0 : p2 >= p0
            softWarn := not hardInvalid and ((not na(retrace) and retrace < wave2MinRetrace) or time2 > time1 * wave2MaxTime)
            note := "Wave 2: retrace " + str.tostring(retrace * 100.0, "#.##") + "%, time x " + str.tostring(time2 / time1, "#.##")
        if phase == 3 and index >= 3
            p0 = array.get(swingPrices, cycleStart)
            p1 = array.get(swingPrices, cycleStart + 1)
            p2 = array.get(swingPrices, cycleStart + 2)
            p3 = array.get(swingPrices, cycleStart + 3)
            wave1 = math.abs(p1 - p0)
            wave3 = math.abs(p3 - p2)
            ratio = wave1 > 0 ? wave3 / wave1 : na
            softWarn := not na(ratio) and ratio < wave3MinExtension
            t0 = array.get(swingBars, cycleStart)
            t1 = array.get(swingBars, cycleStart + 1)
            t2 = array.get(swingBars, cycleStart + 2)
            t3 = array.get(swingBars, cycleStart + 3)
            time1 = math.max(1, t1 - t0)
            time2 = math.max(1, t2 - t1)
            time3 = math.max(1, t3 - t2)
            equal12 = math.abs(time1 - time2) <= time1 * 0.05
            expected3 = equal12 ? time1 + time2 : (time1 + time2) / 2.0
            timeWarn = expected3 > 0 and math.abs(time3 - expected3) / expected3 > timeTolerance
            softWarn := softWarn or timeWarn
            note := "Wave 3: " + str.tostring(ratio * 100.0, "#.##") + "% of Wave 1, time " + str.tostring(time3) + " bars vs rule " + str.tostring(expected3, "#.##")
        if showWave4Internal and phase == 4 and index >= 4
            p2 = array.get(swingPrices, cycleStart + 2)
            p3 = array.get(swingPrices, cycleStart + 3)
            pA = array.get(swingPrices, cycleStart + 4)
            wave3 = math.abs(p3 - p2)
            aRetrace = wave3 > 0 ? math.abs(p3 - pA) / wave3 : na
            softWarn := not na(aRetrace) and aRetrace > flatAMaxRetrace
            note := "Wave 4 A: retrace " + str.tostring(aRetrace * 100.0, "#.##") + "% of W3, flat max " + str.tostring(flatAMaxRetrace * 100.0, "#.##") + "%"
        if showWave4Internal and phase == 5 and index >= 5
            p3 = array.get(swingPrices, cycleStart + 3)
            pA = array.get(swingPrices, cycleStart + 4)
            pB = array.get(swingPrices, cycleStart + 5)
            aLength = math.abs(p3 - pA)
            bRetrace = aLength > 0 ? math.abs(pB - pA) / aLength : na
            softWarn := not na(bRetrace) and (bRetrace < flatBMinRetrace or bRetrace > flatBMaxRetrace)
            note := "B wave: " + str.tostring(bRetrace * 100.0, "#.##") + "% of A, flat range " + str.tostring(flatBMinRetrace * 100.0, "#.##") + "-" + str.tostring(flatBMaxRetrace * 100.0, "#.##") + "%"
        if phase == wave4Phase and index >= wave4Phase
            p1 = array.get(swingPrices, cycleStart + 1)
            p2 = array.get(swingPrices, cycleStart + 2)
            p3 = array.get(swingPrices, cycleStart + 3)
            p4 = array.get(swingPrices, cycleStart + wave4Phase)
            bullish = p3 > p2
            wave3 = math.abs(p3 - p2)
            retrace = wave3 > 0 ? math.abs(p3 - p4) / wave3 : na
            hardInvalid := bullish ? p4 <= p1 : p4 >= p1
            softWarn := not hardInvalid and not na(retrace) and (retrace < wave4MinRetrace or retrace > wave4MaxRetrace)
            t2 = array.get(swingBars, cycleStart + 2)
            t3 = array.get(swingBars, cycleStart + 3)
            t4 = array.get(swingBars, cycleStart + wave4Phase)
            time2 = math.max(1, t2 - array.get(swingBars, cycleStart + 1))
            time4 = math.max(1, t4 - t3)
            timeRatio4 = time4 / time2
            nearHalf = math.abs(timeRatio4 - 0.5) <= timeTolerance
            nearTwo = math.abs(timeRatio4 - 2.0) <= timeTolerance
            nearThree = math.abs(timeRatio4 - 3.0) <= timeTolerance
            timeWarn4 = not (nearHalf or nearTwo or nearThree)
            softWarn := softWarn or timeWarn4
            wave4Label = showWave4Internal ? "Wave 4/C" : "Wave 4"
            note := wave4Label + ": retrace " + str.tostring(retrace * 100.0, "#.##") + "%, time " + str.tostring(timeRatio4, "#.##") + "x W2, correction " + correctionPattern
        if phase == wave5Phase and index >= wave5Phase
            p0 = array.get(swingPrices, cycleStart)
            p1 = array.get(swingPrices, cycleStart + 1)
            p2 = array.get(swingPrices, cycleStart + 2)
            p3 = array.get(swingPrices, cycleStart + 3)
            p4 = array.get(swingPrices, cycleStart + wave4Phase)
            p5 = array.get(swingPrices, cycleStart + wave5Phase)
            wave1 = math.abs(p1 - p0)
            wave3 = math.abs(p3 - p2)
            wave5 = math.abs(p5 - p4)
            base = math.abs(p3 - p4)
            ratio = base > 0 ? wave5 / base : na
            hardInvalid := wave3 < wave1 and wave3 < wave5
            softWarn := not hardInvalid and not na(ratio) and (ratio < wave5MinExtension or ratio > wave5MaxExtension)
            note := "Wave 5: " + str.tostring(ratio * 100.0, "#.##") + "% of Wave 3-4"
    [hardInvalid, softWarn, note]
f_latest_time_note() =>
    note = "Waiting for Wave 2"
    state = "..."
    count = array.size(swingBars)
    if count >= 3
        latest = count - 1
        searchLimit = int(math.min(count - 3, 120))
        for offset = 0 to searchLimit
            i = latest - offset
            phase = f_wave_phase(i)
            if phase >= 2 and note == "Waiting for Wave 2"
                cycleStart = i - phase
                if cycleStart >= 0 and array.size(swingBars) > cycleStart + 2
                    t0 = array.get(swingBars, cycleStart)
                    t1 = array.get(swingBars, cycleStart + 1)
                    t2 = array.get(swingBars, cycleStart + 2)
                    time1 = math.max(1, t1 - t0)
                    time2 = math.max(1, t2 - t1)
                    ratio2 = time2 / time1
                    state := ratio2 <= wave2MaxTime ? "OK" : "WARN"
                    note := "W2 " + str.tostring(ratio2, "#.##") + "x W1 | rule 0.25/0.5/1/2x"
                    if phase >= 3 and array.size(swingBars) > cycleStart + 3
                        t3 = array.get(swingBars, cycleStart + 3)
                        time3 = math.max(1, t3 - t2)
                        equal12 = math.abs(time1 - time2) <= time1 * 0.05
                        expected3 = equal12 ? time1 + time2 : (time1 + time2) / 2.0
                        ratio3 = expected3 > 0 ? time3 / expected3 : na
                        state := not na(ratio3) and math.abs(ratio3 - 1.0) <= timeTolerance ? "OK" : "WARN"
                        note := "W3 " + str.tostring(time3) + " bars | rule " + str.tostring(expected3, "#.##")
                    wave4Phase = f_wave4_complete_phase()
                    if phase >= wave4Phase and array.size(swingBars) > cycleStart + wave4Phase
                        t3 = array.get(swingBars, cycleStart + 3)
                        t4 = array.get(swingBars, cycleStart + wave4Phase)
                        time4 = math.max(1, t4 - t3)
                        ratio4 = time4 / time2
                        nearHalf = math.abs(ratio4 - 0.5) <= timeTolerance
                        nearTwo = math.abs(ratio4 - 2.0) <= timeTolerance
                        nearThree = math.abs(ratio4 - 3.0) <= timeTolerance
                        state := nearHalf or nearTwo or nearThree ? "OK" : "WARN"
                        note := "W4 " + str.tostring(ratio4, "#.##") + "x W2 | rule 0.5/2/3x"
    [state, note]

f_update_time_table() =>
    if showTimeTable and barstate.islast
        if engineMode == "Candidate State (Phase 1)"
            stateColor = candidateState == "CONFIRMED" ? color.new(color.green, 0) : candidateState == "INVALID" ? color.new(color.red, 0) : color.new(color.orange, 0)
            table.cell(timeTable, 0, 0, "EW Phase 1", text_color=color.white, bgcolor=color.new(color.black, 0))
            table.cell(timeTable, 1, 0, candidateState, text_color=color.white, bgcolor=stateColor)
            table.cell(timeTable, 0, 1, "Degree", text_color=color.white, bgcolor=color.new(color.black, 15))
            table.cell(timeTable, 1, 1, degreeName + " / " + degreeSourceTimeframe, text_color=color.white, bgcolor=color.new(color.black, 15))
            table.cell(timeTable, 0, 2, "Point 0", text_color=color.white, bgcolor=color.new(color.black, 15))
            table.cell(timeTable, 1, 2, baseLocked ? "LOCKED " + str.tostring(lockedBasePrice, format.mintick) : "searching", text_color=color.white, bgcolor=color.new(color.black, 15))
            table.cell(timeTable, 0, 3, "W1 evidence", text_color=color.white, bgcolor=color.new(color.black, 15))
            table.cell(timeTable, 1, 3, baseLocked ? str.tostring(lockedInternalCount) + " moves / " + str.tostring(lockedDegreeProgress * 100.0, "#.##") + "%" : "waiting", text_color=color.white, bgcolor=color.new(color.black, 15))
            table.cell(timeTable, 0, 4, "Reason", text_color=color.white, bgcolor=color.new(color.black, 15))
            table.cell(timeTable, 1, 4, lastReasonCode, text_color=color.white, bgcolor=color.new(color.black, 15))
            table.cell(timeTable, 0, 5, "Recounts / Alt", text_color=color.white, bgcolor=color.new(color.black, 15))
            table.cell(timeTable, 1, 5, str.tostring(recountCount) + " / " + str.tostring(alternateBaseCount), text_color=color.white, bgcolor=color.new(color.black, 15))
            table.cell(timeTable, 0, 6, "Next", text_color=color.white, bgcolor=color.new(color.black, 15))
            table.cell(timeTable, 1, 6, baseLocked ? "W2 classifier pending" : "qualified 0-1", text_color=color.white, bgcolor=color.new(color.black, 15))
        else
            [state, note] = f_latest_time_note()
            table.cell(timeTable, 0, 0, "EW Time", text_color=color.white, bgcolor=color.new(color.black, 0))
            table.cell(timeTable, 1, 0, state, text_color=color.white, bgcolor=state == "WARN" ? color.new(color.orange, 0) : color.new(color.green, 0))
            table.cell(timeTable, 0, 1, "Rule", text_color=color.white, bgcolor=color.new(color.black, 15))
            table.cell(timeTable, 1, 1, "Wave 2 <= " + str.tostring(wave2MaxTime, "#.##") + "x Wave 1", text_color=color.white, bgcolor=color.new(color.black, 15))
            table.cell(timeTable, 0, 2, "Latest", text_color=color.white, bgcolor=color.new(color.black, 15))
            table.cell(timeTable, 1, 2, note, text_color=color.white, bgcolor=color.new(color.black, 15))
            table.cell(timeTable, 0, 3, "Correction", text_color=color.white, bgcolor=color.new(color.black, 15))
            table.cell(timeTable, 1, 3, correctionPattern, text_color=color.white, bgcolor=color.new(color.black, 15))
            for row = 4 to 6
                table.cell(timeTable, 0, row, "", bgcolor=color.new(color.black, 100))
                table.cell(timeTable, 1, row, "", bgcolor=color.new(color.black, 100))
    else if not showTimeTable and barstate.islast
        table.clear(timeTable, 0, 0, 1, 6)

f_label_color(phase, hardInvalid, softWarn) =>
    if hardInvalid
        color.new(color.red, 0)
    else if softWarn
        color.new(color.orange, 0)
    else if f_is_impulse_phase(phase)
        color.new(color.black, 0)
    else
        color.new(color.teal, 0)


f_fib_ratio(index) =>
    index == 0 ? 0.0 : index == 1 ? 0.14 : index == 2 ? 0.236 : index == 3 ? 0.382 : index == 4 ? 0.5 : index == 5 ? 0.618 : index == 6 ? 0.812 : index == 7 ? 1.0 : index == 8 ? 1.11 : 1.272

f_fib_text(index) =>
    index == 0 ? "0.00%" : index == 1 ? "14.00%" : index == 2 ? "23.60%" : index == 3 ? "38.20%" : index == 4 ? "50.00%" : index == 5 ? "61.80%" : index == 6 ? "81.20%" : index == 7 ? "100.00%" : index == 8 ? "111.00%" : "127.20%"

f_anchor_fib_price(anchorIndex, ratio) =>
    importantHigh = array.get(swingImportantHigh, anchorIndex)
    importantLow = array.get(swingImportantLow, anchorIndex)
    importantRange = importantHigh - importantLow
    anchorType = array.get(swingTypes, anchorIndex)
    not na(importantRange) and importantRange > 0 ? (anchorType == -1 ? importantLow + importantRange * ratio : importantHigh - importantRange * ratio) : na

f_draw_anchor_fib(anchorIndex) =>
    if showAnchorFib and anchorIndex >= 0 and array.size(swingBars) > anchorIndex
        anchorBar = array.get(swingBars, anchorIndex)
        for fibIndex = 0 to 9
            ratio = f_fib_ratio(fibIndex)
            price = f_anchor_fib_price(anchorIndex, ratio)
            if not na(price)
                opacity = ratio == 0.0 or ratio == 1.0 ? 35 : 55
                ln = line.new(anchorBar, price, bar_index, price, extend=extend.right, color=color.new(fibLineColor, opacity), width=1)
                lb = label.new(bar_index, price, text=f_fib_text(fibIndex) + " (" + str.tostring(price, format.mintick) + ")", style=label.style_label_left, yloc=yloc.price, color=color.new(color.white, 100), textcolor=fibLineColor, size=size.tiny)
                array.push(anchorFibLines, ln)
                array.push(anchorFibLabels, lb)

f_draw_wave5_targets(cycleStart) =>
    wave4Phase = f_wave4_complete_phase()
    if showTargets and cycleStart >= 0 and array.size(swingPrices) > cycleStart + wave4Phase
        p3 = array.get(swingPrices, cycleStart + 3)
        p4 = array.get(swingPrices, cycleStart + wave4Phase)
        b4 = array.get(swingBars, cycleStart + wave4Phase)
        bullish = p3 > p4
        base = math.abs(p3 - p4)
        minTarget = bullish ? p4 + base * wave5MinExtension : p4 - base * wave5MinExtension
        maxTarget = bullish ? p4 + base * wave5MaxExtension : p4 - base * wave5MaxExtension
        minLine = line.new(b4, minTarget, bar_index, minTarget, extend=extend.right, color=color.new(color.green, 45), style=line.style_dashed)
        maxLine = line.new(b4, maxTarget, bar_index, maxTarget, extend=extend.right, color=color.new(color.green, 70), style=line.style_dotted)
        array.push(targetLines, minLine)
        array.push(targetLines, maxLine)

f_draw_locked_fib() =>
    importantRange = lockedImportantHigh - lockedImportantLow
    if showAnchorFib and baseLocked and not na(importantRange) and importantRange > 0
        for fibIndex = 0 to 9
            ratio = f_fib_ratio(fibIndex)
            price = lockedBullish ? lockedImportantLow + importantRange * ratio : lockedImportantHigh - importantRange * ratio
            opacity = ratio == 0.0 or ratio == 1.0 ? 35 : 55
            ln = line.new(lockedBaseBar, price, bar_index, price, extend=extend.right, color=color.new(fibLineColor, opacity), width=1)
            lb = label.new(bar_index, price, text=f_fib_text(fibIndex) + " (" + str.tostring(price, format.mintick) + ")", style=label.style_label_left, yloc=yloc.price, color=color.new(color.white, 100), textcolor=fibLineColor, size=size.tiny)
            array.push(anchorFibLines, ln)
            array.push(anchorFibLabels, lb)

f_redraw_candidate() =>
    f_clear_drawings()
    if baseLocked
        ln = line.new(lockedBaseBar, lockedBasePrice, lockedW1Bar, lockedW1Price, color=impulseLineColor, width=3)
        array.push(drawnLines, ln)
        baseStyle = lockedBullish ? label.style_label_up : label.style_label_down
        w1Style = lockedBullish ? label.style_label_down : label.style_label_up
        baseLabel = label.new(lockedBaseBar, lockedBasePrice, text="0", style=baseStyle, yloc=yloc.price, color=color.new(color.black, 0), textcolor=labelTextColor, size=f_label_size(), tooltip="Locked Point 0. It changes only after a hard origin invalidation.")
        w1Tooltip = "CONFIRMED | " + str.tostring(lockedInternalCount) + " internal moves | degree " + str.tostring(lockedDegreeProgress * 100.0, "#.##") + "%"
        w1Label = label.new(lockedW1Bar, lockedW1Price, text="1", style=w1Style, yloc=yloc.price, color=color.new(color.black, 0), textcolor=labelTextColor, size=f_label_size(), tooltip=w1Tooltip)
        array.push(drawnLabels, baseLabel)
        array.push(drawnLabels, w1Label)
        f_draw_locked_fib()
        if showDevelopingCandidates and str.length(developingText) > 0 and array.size(swingBars) > 0
            latestIndex = array.size(swingBars) - 1
            latestBar = array.get(swingBars, latestIndex)
            if latestBar != lockedW1Bar
                latestPrice = array.get(swingPrices, latestIndex)
                latestType = array.get(swingTypes, latestIndex)
                latestStyle = latestType == 1 ? label.style_label_down : label.style_label_up
                candidateLabel = label.new(latestBar, latestPrice, text=developingText, style=latestStyle, yloc=yloc.price, color=color.new(color.gray, 35), textcolor=color.white, size=size.tiny, tooltip="Raw pivot only; not promoted to a main Elliott label in Phase 1.")
                array.push(drawnLabels, candidateLabel)
    if not na(lastInvalidBar)
        invalidLabel = label.new(lastInvalidBar, lastInvalidPrice, text="INVALID\nrecount " + str.tostring(recountCount), style=label.style_label_down, yloc=yloc.price, color=color.new(color.red, 0), textcolor=color.white, size=size.tiny, tooltip="W2_ORIGIN_BREAK: the locked Point 0 was crossed and released.")
        array.push(drawnLabels, invalidLabel)

f_redraw() =>
    f_clear_drawings()
    count = array.size(swingBars)
    if count > 0
        latestAnchor = f_valid_anchor_index(count - 1)
        f_draw_anchor_fib(latestAnchor)
        for i = 0 to count - 1
            b = array.get(swingBars, i)
            p = array.get(swingPrices, i)
            t = array.get(swingTypes, i)
            phase = f_wave_phase(i)
            cycleStart = phase >= 0 ? i - phase : -1
            if phase >= 0
                if i > 0
                    prevPhase = f_wave_phase(i - 1)
                    prevCycleStart = prevPhase >= 0 ? (i - 1) - prevPhase : -1
                    if prevPhase >= 0 and prevCycleStart == cycleStart
                        prevBar = array.get(swingBars, i - 1)
                        prevPrice = array.get(swingPrices, i - 1)
                        lineColor = f_is_impulse_phase(phase) ? impulseLineColor : correctionLineColor
                        ln = line.new(prevBar, prevPrice, b, p, color=lineColor, width=2)
                        array.push(drawnLines, ln)
                if showZero or phase != 0
                    [hardInvalid, softWarn, note] = f_rule_state(i, phase)
                    style = t == 1 ? label.style_label_down : label.style_label_up
                    lbl = label.new(b, p, text=f_phase_text(phase), style=style, yloc=yloc.price, color=f_label_color(phase, hardInvalid, softWarn), textcolor=labelTextColor, size=f_label_size(), tooltip=note)
                    array.push(drawnLabels, lbl)
                if phase == f_wave4_complete_phase()
                    f_draw_wave5_targets(cycleStart)
pivotHigh = ta.pivothigh(high, pivotLeft, pivotRight)
pivotLow = ta.pivotlow(low, pivotLeft, pivotRight)
pivotBar = bar_index - pivotRight
atrValue = ta.atr(importantAtrLength)
rsiValue = ta.rsi(close, rsiLength)
macdLine = ta.ema(close, macdFast) - ta.ema(close, macdSlow)
macdSignalLine = ta.ema(macdLine, macdSignal)
macdHist = macdLine - macdSignalLine
pivotAtr = atrValue[pivotRight]
pivotRsi = rsiValue[pivotRight]
pivotMacdHist = macdHist[pivotRight]
degreeImportantHigh = request.security(syminfo.tickerid, degreeSourceTimeframe, ta.highest(high, importantLookbackDays), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
degreeImportantLow = request.security(syminfo.tickerid, degreeSourceTimeframe, ta.lowest(low, importantLookbackDays), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
importantHighSeries = engineMode == "Candidate State (Phase 1)" ? degreeImportantHigh : ta.highest(high, importantLookback)
importantLowSeries = engineMode == "Candidate State (Phase 1)" ? degreeImportantLow : ta.lowest(low, importantLookback)
importantHighAtPivot = importantHighSeries[pivotRight]
importantLowAtPivot = importantLowSeries[pivotRight]
importantRangeAtPivot = importantHighAtPivot - importantLowAtPivot
highIsImportant = pivotHigh >= importantHighAtPivot
lowIsImportant = pivotLow <= importantLowAtPivot
macdLowestAtPivot = pivotMacdHist <= ta.lowest(macdHist, oscillatorLookback)[pivotRight]
macdHighestAtPivot = pivotMacdHist >= ta.highest(macdHist, oscillatorLookback)[pivotRight]
changed = false

if not na(pivotHigh) and not na(pivotLow)
    lastPrice = array.size(swingPrices) > 0 ? array.get(swingPrices, array.size(swingPrices) - 1) : close[pivotRight]
    useHigh = math.abs(pivotHigh - lastPrice) >= math.abs(pivotLow - lastPrice)
    changed := useHigh ? f_upsert_swing(pivotBar, pivotHigh, 1, pivotAtr, pivotMacdHist, pivotRsi, macdHighestAtPivot, highIsImportant, importantRangeAtPivot, importantHighAtPivot, importantLowAtPivot) : f_upsert_swing(pivotBar, pivotLow, -1, pivotAtr, pivotMacdHist, pivotRsi, macdLowestAtPivot, lowIsImportant, importantRangeAtPivot, importantHighAtPivot, importantLowAtPivot)
else if not na(pivotHigh)
    changed := f_upsert_swing(pivotBar, pivotHigh, 1, pivotAtr, pivotMacdHist, pivotRsi, macdHighestAtPivot, highIsImportant, importantRangeAtPivot, importantHighAtPivot, importantLowAtPivot)
else if not na(pivotLow)
    changed := f_upsert_swing(pivotBar, pivotLow, -1, pivotAtr, pivotMacdHist, pivotRsi, macdLowestAtPivot, lowIsImportant, importantRangeAtPivot, importantHighAtPivot, importantLowAtPivot)

originBroken = engineMode == "Candidate State (Phase 1)" and baseLocked and bar_index > lockedAtBar and (lockedBullish ? low <= lockedBasePrice : high >= lockedBasePrice)
if originBroken
    baseLocked := false
    candidateState := "INVALID"
    lastReasonCode := "W2_ORIGIN_BREAK"
    recountCount += 1
    searchFloorBar := bar_index
    lastInvalidBar := bar_index
    lastInvalidPrice := lockedBullish ? low : high
    developingText := ""
    lockedBaseBar := na
    lockedBasePrice := na
    lockedW1Bar := na
    lockedW1Price := na
    lockedAtBar := na
    lockedDegreeProgress := na
    lockedInternalCount := na
    lockedImportantHigh := na
    lockedImportantLow := na
    f_redraw_candidate()

if changed
    if engineMode == "Candidate State (Phase 1)"
        if baseLocked
            latestIndex = array.size(swingBars) - 1
            latestType = array.get(swingTypes, latestIndex)
            baseType = lockedBullish ? -1 : 1
            sameAsBase = latestType == baseType
            latestImportant = array.get(swingImportantExtreme, latestIndex)
            [latestOscillatorOk, latestExtreme, latestDivergence] = f_candidate_oscillator(latestIndex, lockedBullish)
            isAlternate = sameAsBase and latestImportant and latestOscillatorOk
            if isAlternate
                alternateBaseCount += 1
                candidateState := "ALTERNATE"
                lastReasonCode := "LOCKED_BASE_ALTERNATE"
                developingText := "Alt 0"
            else
                candidateState := "FORMING"
                lastReasonCode := "W2_CLASSIFIER_PENDING"
                developingText := sameAsBase ? "2?" : "raw"
        else
            [candidateStart, candidateEnd, candidateBullish, candidateProgress, candidateCount, candidateNote] = f_find_phase1_candidate()
            if candidateStart >= 0
                baseLocked := true
                lockedBullish := candidateBullish
                lockedBaseBar := array.get(swingBars, candidateStart)
                lockedBasePrice := array.get(swingPrices, candidateStart)
                lockedW1Bar := array.get(swingBars, candidateEnd)
                lockedW1Price := array.get(swingPrices, candidateEnd)
                lockedAtBar := bar_index
                lockedDegreeProgress := candidateProgress
                lockedInternalCount := candidateCount
                lockedImportantHigh := array.get(swingImportantHigh, candidateStart)
                lockedImportantLow := array.get(swingImportantLow, candidateStart)
                candidateState := "CONFIRMED"
                lastReasonCode := "W1_CONFIRMED"
                developingText := ""
            else if not originBroken
                candidateState := "SEARCHING"
                lastReasonCode := "SEARCHING_FOR_BASE"
                developingText := ""
        f_redraw_candidate()
    else
        f_redraw()

f_update_time_table()
