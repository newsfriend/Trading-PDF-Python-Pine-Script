        else
            [candidateStart, candidateEnd, candidateBullish, candidateProgress, candidateCount, candidateSubtype, candidateNote] = f_find_phase1_candidate()
            if candidateStart >= 0
                baseLocked := true
                lockedBullish := candidateBullish
                lockedBaseBar := array.get(swingBars, candidateStart)
                lockedBasePrice := array.get(swingPrices, candidateStart)
                lockedW1Bar := array.get(swingBars, candidateEnd)
                lockedW1Price := array.get(swingPrices, candidateEnd)
                lockedAtBar := bar_index
                lockedDegreeProgress := candidateProgress
                lockedInternalCount := candidateCount
                lockedW1Subtype := candidateSubtype
                lockedImportantHigh := array.get(swingImportantHigh, candidateStart)
                lockedImportantLow := array.get(swingImportantLow, candidateStart)
                engineStage := "W2_CORRECTION_CONTAINER"
                candidateState := "CONFIRMED"
                lastReasonCode := "W1_CONFIRMED"
                primaryPattern := str.contains(candidateSubtype, "LEADING_DIAGONAL") ? "Leading Diagonal" : "Motive"
                alternatePattern := ""
                currentFibAnchor := "Important H/L"
                currentFibValue := candidateProgress
                currentTimeValue := na
                currentInternalPattern := str.contains(candidateSubtype, "LEADING_DIAGONAL") ? "5-3-5-3-5" : str.tostring(candidateCount) + "-move impulse"
                currentInternalCount := candidateCount
                currentMacdState := ""
                currentNextCondition := "Need a valid W2 correction completion while Point 0 remains intact."
                hpSignalState := ""
                currentConfidence := na
                currentChannelState := ""
                currentChannelTarget := na
                currentTargetCluster := ""
                fbdCandidateState := ""
                developingText := ""
            else if not originBroken
                candidateState := "SEARCHING"
                lastReasonCode := "SEARCHING_FOR_BASE"
                engineStage := "SEARCHING"
                primaryPattern := ""
                alternatePattern := ""
                currentFibAnchor := ""
                currentFibValue := na
                currentInternalPattern := ""
                currentInternalCount := 0
                currentNextCondition := "Need qualified Point 0 and Wave 1"
                developingText := ""
        f_redraw_candidate()
    else
        f_redraw()

if showDegreeDashboard and barstate.islast
    routeNames = array.from("Monthly", "Weekly", "Daily", "288 Minute", "Four Hour", "Hourly", "Fifteen Minute", "Five Minute", "Three Minute")
    routeFrames = array.from("M", "W", "D", "288", "240", "60", "15", "5", "3")
    routeParents = array.from("-", "M", "W", "D", "D", "240 / ctx 288", "60", "15", "5")
    routeStates = array.from(f_route_state_text(routeMDir), f_route_state_text(routeWDir), f_route_state_text(routeDDir), f_route_state_text(route288Dir), f_route_state_text(route240Dir), f_route_state_text(route60Dir), f_route_state_text(route15Dir), f_route_state_text(route5Dir), f_route_state_text(route3Dir))
    routeMoveCounts = array.from(routeMMoves, routeWMoves, routeDMoves, route288Moves, route240Moves, route60Moves, route15Moves, route5Moves, route3Moves)
    routeAlignments = array.from("ROOT", f_route_alignment_text(routeWDir, routeMDir, true), f_route_alignment_text(routeDDir, routeWDir, true), f_route_alignment_text(route288Dir, routeDDir, true), f_route_alignment_text(route240Dir, routeDDir, true), f_route_alignment_text(route60Dir, route240Dir, true) + " / " + f_route_alignment_text(route60Dir, route288Dir, true), f_route_alignment_text(route15Dir, route60Dir, true), f_route_alignment_text(route5Dir, route15Dir, true), f_route_alignment_text(route3Dir, route5Dir, true))
    for column = 0 to 4
        header = column == 0 ? "Degree" : column == 1 ? "TF" : column == 2 ? "Parent" : column == 3 ? "State / moves" : "Alignment"
        table.cell(degreeTable, column, 0, header, text_color=color.white, bgcolor=color.new(color.black, 0))
    for routeIndex = 0 to 8
        selectedRoute = timeframe.period == array.get(routeFrames, routeIndex)
        routeColor = selectedRoute ? color.new(color.blue, 55) : color.new(color.black, 15)
        table.cell(degreeTable, 0, routeIndex + 1, array.get(routeNames, routeIndex), text_color=color.white, bgcolor=routeColor)
        table.cell(degreeTable, 1, routeIndex + 1, array.get(routeFrames, routeIndex), text_color=color.white, bgcolor=routeColor)
        table.cell(degreeTable, 2, routeIndex + 1, array.get(routeParents, routeIndex), text_color=color.white, bgcolor=routeColor)
        table.cell(degreeTable, 3, routeIndex + 1, array.get(routeStates, routeIndex) + " / " + str.tostring(array.get(routeMoveCounts, routeIndex)), text_color=color.white, bgcolor=routeColor)
        table.cell(degreeTable, 4, routeIndex + 1, array.get(routeAlignments, routeIndex), text_color=color.white, bgcolor=routeColor)
else if not showDegreeDashboard and barstate.islast
    table.clear(degreeTable, 0, 0, 4, 9)

f_update_time_table()

// V4 alerts are state transitions and fire only after the counted bar closes.
stateChanged = barstate.isconfirmed and (lastReasonCode != lastReasonCode[1] or candidateState != candidateState[1])
alertcondition(stateChanged and candidateState == "FORMING", "EW FORMING", "EW FORMING | {{ticker}} | chart {{interval}}")
alertcondition(stateChanged and candidateState == "CONFIRMED", "EW CONFIRMED", "EW CONFIRMED | {{ticker}} | chart {{interval}}")
alertcondition(stateChanged and candidateState == "INVALID", "EW INVALID", "EW INVALID | {{ticker}} | chart {{interval}}")
alertcondition(stateChanged and lastReasonCode == "W2_ORIGIN_BREAK", "EW CONTROLLED RECOUNT", "EW CONTROLLED_RECOUNT | {{ticker}} | chart {{interval}}")
alertcondition(stateChanged and lastReasonCode == "CORRECTION_COMPLETE", "EW CORRECTION COMPLETE", "EW CORRECTION_COMPLETE | {{ticker}} | chart {{interval}}")
alertcondition(stateChanged and str.contains(hpSignalState, "HP BUY"), "EW HP BUY", "EW HP_BUY | {{ticker}} | chart {{interval}}")
alertcondition(stateChanged and str.contains(hpSignalState, "HP SELL"), "EW HP SELL", "EW HP_SELL | {{ticker}} | chart {{interval}}")
alertcondition(stateChanged and str.length(fbdCandidateState) > 0, "EW FBD FBO CANDIDATE", "EW FBD_FBO_CANDIDATE | {{ticker}} | chart {{interval}}")

plot(currentChannelTarget, "EW channel target", color=color.new(color.blue, 100), display=display.data_window)
plot(not na(currentConfidence) ? math.min(100.0, currentConfidence + routeConfidenceBonus) : na, "EW confidence", color=color.new(color.gray, 100), display=display.data_window)
